model academicyear {
  id                    Int                     @id @default(autoincrement())
  schoolId              Int
  name                  String
  startDate             DateTime?
  endDate               DateTime?
  isActive              Boolean                 @default(true)
  createdAt             DateTime                @default(now())
  updatedAt             DateTime
  school                school                  @relation(fields: [schoolId], references: [id], map: "AcademicYear_schoolId_fkey")
  admission             admission[]
  exam                  exam[]
  feestructure          feestructure[]
  studentacademicrecord studentacademicrecord[]

  @@index([schoolId], map: "AcademicYear_schoolId_fkey")
}

model admission {
  id                 Int                     @id @default(autoincrement())
  studentId          Int?
  studentName        String
  schoolId           Int
  classId            Int
  sectionId          Int?
  status             admission_status        @default(PENDING)
  createdAt          DateTime                @default(now())
  admissionNo        String?
  rollNumber         Int?
  academicYearId     Int
  dob                DateTime?
  gender             admission_gender?
  address            String?
  admissionDate      DateTime?               @default(now())
  admissionType      admission_admissionType @default(NEW)
  approvedAt         DateTime?
  email              String?
  medium             String?
  phoneNumber        String?
  previousBoard      String?
  previousClass      String?
  previousPercentage Float?
  previousSchool     String?
  tcNumber           String?
  aadharNumber       String?
  bloodGroup         String?
  caste              String?
  fatherEmail        String?
  fatherName         String?
  fatherOccupation   String?
  fatherPhone        String?
  guardianEmail      String?
  guardianName       String?
  guardianPhone      String?
  guardianRelation   String?
  motherEmail        String?
  motherName         String?
  motherOccupation   String?
  motherPhone        String?
  nationality        String?
  religion           String?
  academicyear       academicyear            @relation(fields: [academicYearId], references: [id], map: "Admission_academicYearId_fkey")
  Renamedclass       Renamedclass            @relation(fields: [classId], references: [id], map: "Admission_classId_fkey")
  school             school                  @relation(fields: [schoolId], references: [id], map: "Admission_schoolId_fkey")
  section            section?                @relation(fields: [sectionId], references: [id], map: "Admission_sectionId_fkey")
  student            student?                @relation(fields: [studentId], references: [id], map: "Admission_studentId_fkey")

  @@index([academicYearId], map: "Admission_academicYearId_fkey")
  @@index([classId], map: "Admission_classId_fkey")
  @@index([schoolId], map: "Admission_schoolId_idx")
  @@index([sectionId], map: "Admission_sectionId_fkey")
  @@index([studentId], map: "Admission_studentId_fkey")
}

model auditlog {
  id        Int      @id @default(autoincrement())
  userId    Int
  action    String
  entity    String
  entityId  Int?
  createdAt DateTime @default(now())
}

model bookpackage {
  id           Int          @id @default(autoincrement())
  schoolId     Int
  classId      Int
  name         String
  amount       Float
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime
  Renamedclass Renamedclass @relation(fields: [classId], references: [id], map: "BookPackage_classId_fkey")
  school       school       @relation(fields: [schoolId], references: [id], map: "BookPackage_schoolId_fkey")

  @@index([classId], map: "BookPackage_classId_fkey")
  @@index([schoolId], map: "BookPackage_schoolId_fkey")
}

/// This model has been renamed to 'Renamedclass' during introspection, because the original name 'class' is reserved.
model Renamedclass {
  id                       Int                        @id @default(autoincrement())
  name                     String
  schoolId                 Int
  description              String?
  maxStudents              Int?
  isActive                 Boolean                    @default(true)
  isDeleted                Boolean                    @default(false)
  createdAt                DateTime                   @default(now())
  updatedAt                DateTime
  admission                admission[]
  bookpackage              bookpackage[]
  school                   school                     @relation(fields: [schoolId], references: [id], map: "Class_schoolId_fkey")
  classteacher             classteacher[]
  exam                     exam[]
  feestructure             feestructure[]
  section                  section[]
  studentacademicrecord    studentacademicrecord[]
  studentattendancesession studentattendancesession[]
  syllabus                 syllabus[]
  teachersubject           teachersubject[]
  timetable                timetable[]

  @@unique([name, schoolId], map: "Class_name_schoolId_key")
  @@index([isActive], map: "Class_isActive_idx")
  @@index([isDeleted], map: "Class_isDeleted_idx")
  @@index([schoolId], map: "Class_schoolId_idx")
  @@map("class")
}

model classteacher {
  id           Int          @id @default(autoincrement())
  teacherId    Int
  classId      Int
  sectionId    Int
  createdAt    DateTime     @default(now())
  Renamedclass Renamedclass @relation(fields: [classId], references: [id], map: "ClassTeacher_classId_fkey")
  section      section      @relation(fields: [sectionId], references: [id], map: "ClassTeacher_sectionId_fkey")
  teacher      teacher      @relation(fields: [teacherId], references: [id], map: "ClassTeacher_teacherId_fkey")

  @@unique([classId, sectionId], map: "ClassTeacher_classId_sectionId_key")
  @@index([sectionId], map: "ClassTeacher_sectionId_fkey")
  @@index([teacherId], map: "ClassTeacher_teacherId_fkey")
}

model day {
  id         Int         @id @default(autoincrement())
  schoolId   Int
  name       String
  shortName  String
  order      Int
  maxPeriods Int
  isActive   Boolean     @default(true)
  isHalfDay  Boolean     @default(false)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime
  school     school      @relation(fields: [schoolId], references: [id], map: "Day_schoolId_fkey")
  period     period[]
  timetable  timetable[]

  @@unique([schoolId, name], map: "Day_schoolId_name_key")
}

model designation {
  id   Int    @id @default(autoincrement())
  name String
}

model employeeattendance {
  id             Int                       @id @default(autoincrement())
  schoolId       Int
  employeeId     Int
  attendanceDate DateTime                  @db.Date
  checkInTime    DateTime?
  checkOutTime   DateTime?
  status         employeeattendance_status
  remarks        String?
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime
  user           user                      @relation(fields: [employeeId], references: [id], map: "EmployeeAttendance_employeeId_fkey")
  school         school                    @relation(fields: [schoolId], references: [id], map: "EmployeeAttendance_schoolId_fkey")

  @@unique([employeeId, attendanceDate], map: "EmployeeAttendance_employeeId_attendanceDate_key")
  @@index([schoolId, attendanceDate], map: "EmployeeAttendance_schoolId_attendanceDate_idx")
}

model exam {
  id             Int           @id @default(autoincrement())
  name           String
  classId        Int
  academicYearId Int
  createdAt      DateTime      @default(now())
  endDate        DateTime
  examType       exam_examType
  isPublished    Boolean       @default(false)
  schoolId       Int
  sectionId      Int?
  startDate      DateTime
  updatedAt      DateTime
  academicyear   academicyear  @relation(fields: [academicYearId], references: [id], map: "Exam_academicYearId_fkey")
  Renamedclass   Renamedclass  @relation(fields: [classId], references: [id], map: "Exam_classId_fkey")
  school         school        @relation(fields: [schoolId], references: [id], map: "Exam_schoolId_fkey")
  section        section?      @relation(fields: [sectionId], references: [id], map: "Exam_sectionId_fkey")
  examsubject    examsubject[]

  @@index([academicYearId], map: "Exam_academicYearId_fkey")
  @@index([classId], map: "Exam_classId_fkey")
  @@index([schoolId], map: "Exam_schoolId_fkey")
  @@index([sectionId], map: "Exam_sectionId_fkey")
}

model exammark {
  id            Int         @id @default(autoincrement())
  examSubjectId Int
  studentId     Int
  obtainedMarks Float
  remarks       String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime
  examsubject   examsubject @relation(fields: [examSubjectId], references: [id], onDelete: Cascade, map: "ExamMark_examSubjectId_fkey")
  student       student     @relation(fields: [studentId], references: [id], map: "ExamMark_studentId_fkey")

  @@unique([examSubjectId, studentId], map: "ExamMark_examSubjectId_studentId_key")
  @@index([studentId], map: "ExamMark_studentId_fkey")
}

model examsubject {
  id           Int        @id @default(autoincrement())
  examId       Int
  subjectId    Int
  examDate     DateTime
  totalMarks   Float
  passingMarks Float
  createdAt    DateTime   @default(now())
  updatedAt    DateTime
  exammark     exammark[]
  exam         exam       @relation(fields: [examId], references: [id], onDelete: Cascade, map: "ExamSubject_examId_fkey")
  subject      subject    @relation(fields: [subjectId], references: [id], map: "ExamSubject_subjectId_fkey")

  @@unique([examId, subjectId], map: "ExamSubject_examId_subjectId_key")
  @@index([subjectId], map: "ExamSubject_subjectId_fkey")
}

model feehead {
  id               Int                @id @default(autoincrement())
  schoolId         Int
  name             String
  description      String?
  isOptional       Boolean            @default(false)
  frequency        feehead_frequency  @default(MONTHLY)
  isActive         Boolean            @default(true)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime
  school           school             @relation(fields: [schoolId], references: [id], map: "FeeHead_schoolId_fkey")
  feestructureitem feestructureitem[]
  studentdiscount  studentdiscount[]
  studentfeeitem   studentfeeitem[]

  @@unique([schoolId, name], map: "FeeHead_schoolId_name_key")
}

model feestructure {
  id               Int                @id @default(autoincrement())
  schoolId         Int
  academicYearId   Int
  classId          Int
  name             String
  dueDay           Int
  isActive         Boolean            @default(true)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime
  monthlyFee       Float              @default(0)
  yearlyFee        Float              @default(0)
  oneTimeFee       Float              @default(0)
  academicyear     academicyear       @relation(fields: [academicYearId], references: [id], map: "FeeStructure_academicYearId_fkey")
  Renamedclass     Renamedclass       @relation(fields: [classId], references: [id], map: "FeeStructure_classId_fkey")
  school           school             @relation(fields: [schoolId], references: [id], map: "FeeStructure_schoolId_fkey")
  feestructureitem feestructureitem[]
  studentfee       studentfee[]

  @@unique([schoolId, academicYearId, classId], map: "FeeStructure_schoolId_academicYearId_classId_key")
  @@index([academicYearId], map: "FeeStructure_academicYearId_fkey")
  @@index([classId], map: "FeeStructure_classId_idx")
  @@index([schoolId], map: "FeeStructure_schoolId_idx")
}

model feestructureitem {
  id             Int                        @id @default(autoincrement())
  feeStructureId Int
  feeHeadId      Int
  amount         Decimal                    @db.Decimal(10, 2)
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime
  frequency      feestructureitem_frequency
  feehead        feehead                    @relation(fields: [feeHeadId], references: [id], map: "FeeStructureItem_feeHeadId_fkey")
  feestructure   feestructure               @relation(fields: [feeStructureId], references: [id], onDelete: Cascade, map: "FeeStructureItem_feeStructureId_fkey")

  @@unique([feeStructureId, feeHeadId], map: "FeeStructureItem_feeStructureId_feeHeadId_key")
  @@index([feeHeadId], map: "FeeStructureItem_feeHeadId_fkey")
}

model grade {
  id          Int        @id @default(autoincrement())
  name        String
  schoolId    Int
  description String?
  isActive    Boolean    @default(true)
  isDeleted   Boolean    @default(false)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime
  syllabus    syllabus[]

  @@unique([name, schoolId], map: "Grade_name_schoolId_key")
}

model parent {
  id               Int             @id @default(autoincrement())
  userId           Int             @unique(map: "Parent_userId_key")
  schoolId         Int
  createdAt        DateTime        @default(now())
  updatedAt        DateTime
  fatherEmail      String?
  fatherName       String?
  fatherOccupation String?
  fatherPhone      String?
  guardianName     String?
  guardianPhone    String?
  guardianRelation String?
  motherEmail      String?
  motherName       String?
  motherOccupation String?
  motherPhone      String?
  school           school          @relation(fields: [schoolId], references: [id], map: "Parent_schoolId_fkey")
  user             user            @relation(fields: [userId], references: [id], map: "Parent_userId_fkey")
  studentparent    studentparent[]

  @@index([schoolId], map: "Parent_schoolId_idx")
}

model payment {
  id            Int        @id @default(autoincrement())
  schoolId      Int
  studentId     Int
  studentFeeId  Int
  amount        Decimal    @db.Decimal(12, 2)
  paymentMethod String     @db.VarChar(50)
  status        String     @default("SUCCESS") @db.VarChar(50)
  transactionId String?    @db.VarChar(150)
  referenceNo   String?    @db.VarChar(150)
  paymentDate   DateTime   @default(now())
  remarks       String?    @db.Text
  collectedBy   Int?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @default(now())
  user          user?      @relation(fields: [collectedBy], references: [id], map: "Payment_collectedBy_fkey")
  school        school     @relation(fields: [schoolId], references: [id], map: "Payment_schoolId_fkey")
  studentfee    studentfee @relation(fields: [studentFeeId], references: [id], map: "Payment_studentFeeId_fkey")
  student       student    @relation(fields: [studentId], references: [id], map: "Payment_studentId_fkey")
  refund        refund[]

  @@index([collectedBy], map: "Payment_collectedBy_fkey")
  @@index([paymentDate], map: "Payment_paymentDate_idx")
  @@index([schoolId], map: "Payment_schoolId_idx")
  @@index([status], map: "Payment_status_idx")
  @@index([studentFeeId], map: "Payment_studentFeeId_idx")
  @@index([studentId], map: "Payment_studentId_idx")
  @@index([transactionId], map: "Payment_transactionId_idx")
}

model paymentreceipt {
  id            Int                          @id @default(autoincrement())
  schoolId      Int
  studentId     Int?
  studentFeeId  Int
  paymentId     Int?
  receiptNo     String                       @unique(map: "PaymentReceipt_receiptNo_key")
  amount        Float
  paymentDate   DateTime                     @default(now())
  issuedAt      DateTime?
  paymentMethod paymentreceipt_paymentMethod
  transactionId String?
  remarks       String?
  receivedById  Int?
  status        paymentreceipt_status        @default(SUCCESS)
  createdAt     DateTime                     @default(now())
  updatedAt     DateTime?
  user          user?                        @relation(fields: [receivedById], references: [id], map: "PaymentReceipt_receivedById_fkey")
  school        school                       @relation(fields: [schoolId], references: [id], map: "PaymentReceipt_schoolId_fkey")
  studentfee    studentfee                   @relation(fields: [studentFeeId], references: [id], map: "PaymentReceipt_studentFeeId_fkey")

  @@index([receivedById], map: "PaymentReceipt_receivedById_fkey")
  @@index([schoolId], map: "PaymentReceipt_schoolId_fkey")
  @@index([studentFeeId], map: "PaymentReceipt_studentFeeId_fkey")
}

model payroll {
  id      Int    @id @default(autoincrement())
  staffId Int
  salary  Float
  month   String
}

model period {
  id             Int               @id @default(autoincrement())
  schoolId       Int
  dayId          Int
  periodNumber   Int
  startTime      String
  endTime        String
  isBreak        Boolean           @default(false)
  isActive       Boolean           @default(true)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime
  academicYearId Int
  timingType     period_timingType @default(REGULAR)
  day            day               @relation(fields: [dayId], references: [id], map: "Period_dayId_fkey")
  school         school            @relation(fields: [schoolId], references: [id], map: "Period_schoolId_fkey")
  timetable      timetable[]

  @@unique([schoolId, academicYearId, dayId, periodNumber], map: "Period_schoolId_academicYearId_dayId_periodNumber_key")
  @@index([dayId], map: "Period_dayId_idx")
  @@index([schoolId, academicYearId], map: "Period_schoolId_academicYearId_idx")
}

model permission {
  id             Int              @id @default(autoincrement())
  key            String           @unique(map: "Permission_key_key")
  description    String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime
  rolepermission rolepermission[]
  userpermission userpermission[]
}

model plan {
  id                 Int                  @id @default(autoincrement())
  name               String               @unique(map: "Plan_name_key")
  price              Float
  duration           Int
  features           Json
  createdAt          DateTime             @default(now())
  updatedAt          DateTime
  schoolsubscription schoolsubscription[]
}

model refund {
  id            Int        @id @default(autoincrement())
  schoolId      Int
  studentId     Int
  studentFeeId  Int
  paymentId     Int
  amount        Decimal    @db.Decimal(12, 2)
  reason        String     @db.Text
  refundMethod  String     @db.VarChar(50)
  status        String     @default("PENDING") @db.VarChar(50)
  transactionId String?    @db.VarChar(150)
  refundedBy    Int?
  refundDate    DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @default(now())
  payment       payment    @relation(fields: [paymentId], references: [id], map: "Refund_paymentId_fkey")
  user          user?      @relation(fields: [refundedBy], references: [id], map: "Refund_refundedBy_fkey")
  school        school     @relation(fields: [schoolId], references: [id], map: "Refund_schoolId_fkey")
  studentfee    studentfee @relation(fields: [studentFeeId], references: [id], map: "Refund_studentFeeId_fkey")
  student       student    @relation(fields: [studentId], references: [id], map: "Refund_studentId_fkey")

  @@index([paymentId], map: "Refund_paymentId_idx")
  @@index([refundDate], map: "Refund_refundDate_idx")
  @@index([refundedBy], map: "Refund_refundedBy_fkey")
  @@index([schoolId], map: "Refund_schoolId_idx")
  @@index([status], map: "Refund_status_idx")
  @@index([studentFeeId], map: "Refund_studentFeeId_idx")
  @@index([studentId], map: "Refund_studentId_idx")
}

model role {
  id             Int              @id @default(autoincrement())
  name           String
  schoolId       Int?
  profileType    String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime
  rolepermission rolepermission[]
  userrole       userrole[]

  @@unique([name, schoolId], map: "Role_name_schoolId_key")
}

model rolepermission {
  roleId       Int
  permissionId Int
  permission   permission @relation(fields: [permissionId], references: [id], map: "RolePermission_permissionId_fkey")
  role         role       @relation(fields: [roleId], references: [id], map: "RolePermission_roleId_fkey")

  @@id([roleId, permissionId])
  @@index([permissionId], map: "RolePermission_permissionId_fkey")
}

model scholarship {
  id                 Int                  @id @default(autoincrement())
  schoolId           Int
  name               String
  type               scholarship_type
  amount             Float
  isActive           Boolean              @default(true)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime
  description        String?
  school             school               @relation(fields: [schoolId], references: [id], map: "Scholarship_schoolId_fkey")
  studentscholarship studentscholarship[]

  @@index([schoolId], map: "Scholarship_schoolId_fkey")
}

model school {
  id                       Int                        @id @default(autoincrement())
  name                     String
  email                    String                     @unique(map: "School_email_key")
  phone                    String?
  status                   school_status              @default(PENDING)
  createdAt                DateTime                   @default(now())
  updatedAt                DateTime
  academicyear             academicyear[]
  admission                admission[]
  bookpackage              bookpackage[]
  Renamedclass             Renamedclass[]
  day                      day[]
  employeeattendance       employeeattendance[]
  exam                     exam[]
  feehead                  feehead[]
  feestructure             feestructure[]
  parent                   parent[]
  payment                  payment[]
  paymentreceipt           paymentreceipt[]
  period                   period[]
  refund                   refund[]
  scholarship              scholarship[]
  schoolsubscription       schoolsubscription[]
  schooltiming             schooltiming[]
  section                  section[]
  student                  student[]
  studentacademicrecord    studentacademicrecord[]
  studentattendancesession studentattendancesession[]
  studentdiscount          studentdiscount[]
  studentfee               studentfee[]
  studentscholarship       studentscholarship[]
  teacher                  teacher[]
  timetable                timetable[]
  transportroute           transportroute[]
  user                     user[]
}

model schoolrequest {
  id         Int                  @id @default(autoincrement())
  schoolName String
  email      String
  phone      String
  status     schoolrequest_status @default(PENDING)
  createdAt  DateTime             @default(now())
  updatedAt  DateTime
}

model schoolsubscription {
  id        Int                       @id @default(autoincrement())
  schoolId  Int
  planId    Int
  startDate DateTime
  endDate   DateTime
  status    schoolsubscription_status
  createdAt DateTime                  @default(now())
  updatedAt DateTime
  plan      plan                      @relation(fields: [planId], references: [id], map: "SchoolSubscription_planId_fkey")
  school    school                    @relation(fields: [schoolId], references: [id], map: "SchoolSubscription_schoolId_fkey")

  @@index([planId], map: "SchoolSubscription_planId_fkey")
  @@index([schoolId], map: "SchoolSubscription_schoolId_fkey")
}

model schooltiming {
  id           Int               @id @default(autoincrement())
  schoolId     Int
  academicYear String
  type         schooltiming_type @default(REGULAR)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime
  school       school            @relation(fields: [schoolId], references: [id], map: "SchoolTiming_schoolId_fkey")

  @@unique([schoolId, academicYear, type], map: "SchoolTiming_schoolId_academicYear_type_key")
}

model section {
  id                       Int                        @id @default(autoincrement())
  name                     String
  classId                  Int
  schoolId                 Int
  capacity                 Int?
  description              String?
  isActive                 Boolean                    @default(true)
  createdAt                DateTime                   @default(now())
  updatedAt                DateTime
  admission                admission[]
  classteacher             classteacher[]
  exam                     exam[]
  Renamedclass             Renamedclass               @relation(fields: [classId], references: [id], map: "Section_classId_fkey")
  school                   school                     @relation(fields: [schoolId], references: [id], map: "Section_schoolId_fkey")
  studentacademicrecord    studentacademicrecord[]
  studentattendancesession studentattendancesession[]
  teachersubject           teachersubject[]
  timetable                timetable[]

  @@unique([schoolId, name, classId], map: "Section_schoolId_name_classId_key")
  @@index([classId], map: "Section_classId_fkey")
}

model staff {
  id            Int @id @default(autoincrement())
  userId        Int
  schoolId      Int
  designationId Int
}

model student {
  id                      Int                       @id @default(autoincrement())
  userId                  Int?                      @unique(map: "Student_userId_key")
  schoolId                Int
  address                 String?
  createdAt               DateTime                  @default(now())
  dob                     DateTime?
  updatedAt               DateTime
  isActive                Boolean                   @default(true)
  isDeleted               Boolean                   @default(false)
  name                    String
  studentCode             String                    @unique(map: "Student_studentCode_key")
  gender                  student_gender?
  email                   String?
  phoneNumber             String?
  profilePhoto            String?
  admission               admission[]
  exammark                exammark[]
  payment                 payment[]
  refund                  refund[]
  school                  school                    @relation(fields: [schoolId], references: [id], map: "Student_schoolId_fkey")
  user                    user?                     @relation(fields: [userId], references: [id], map: "Student_userId_fkey")
  studentacademicrecord   studentacademicrecord[]
  studentattendancerecord studentattendancerecord[]
  studentdiscount         studentdiscount[]
  studentfee              studentfee[]
  studentparent           studentparent[]
  studentscholarship      studentscholarship[]

  @@index([schoolId], map: "Student_schoolId_idx")
}

model studentacademicrecord {
  id                          Int                          @id @default(autoincrement())
  schoolId                    Int
  studentId                   Int
  academicYearId              Int
  classId                     Int
  sectionId                   Int?
  rollNumber                  Int
  admissionNo                 String
  isCurrent                   Boolean                      @default(true)
  status                      studentacademicrecord_status @default(ACTIVE)
  promotedFromId              Int?
  createdAt                   DateTime                     @default(now())
  updatedAt                   DateTime
  transportRouteId            Int?
  academicyear                academicyear                 @relation(fields: [academicYearId], references: [id], map: "StudentAcademicRecord_academicYearId_fkey")
  Renamedclass                Renamedclass                 @relation(fields: [classId], references: [id], map: "StudentAcademicRecord_classId_fkey")
  studentacademicrecord       studentacademicrecord?       @relation("studentacademicrecordTostudentacademicrecord", fields: [promotedFromId], references: [id], map: "StudentAcademicRecord_promotedFromId_fkey")
  other_studentacademicrecord studentacademicrecord[]      @relation("studentacademicrecordTostudentacademicrecord")
  school                      school                       @relation(fields: [schoolId], references: [id], map: "StudentAcademicRecord_schoolId_fkey")
  section                     section?                     @relation(fields: [sectionId], references: [id], map: "StudentAcademicRecord_sectionId_fkey")
  student                     student                      @relation(fields: [studentId], references: [id], map: "StudentAcademicRecord_studentId_fkey")
  transportroute              transportroute?              @relation(fields: [transportRouteId], references: [id], map: "StudentAcademicRecord_transportRouteId_fkey")

  @@index([academicYearId], map: "StudentAcademicRecord_academicYearId_idx")
  @@index([classId], map: "StudentAcademicRecord_classId_fkey")
  @@index([promotedFromId], map: "StudentAcademicRecord_promotedFromId_fkey")
  @@index([schoolId], map: "StudentAcademicRecord_schoolId_idx")
  @@index([sectionId], map: "StudentAcademicRecord_sectionId_fkey")
  @@index([studentId], map: "StudentAcademicRecord_studentId_idx")
  @@index([transportRouteId], map: "StudentAcademicRecord_transportRouteId_fkey")
}

model studentattendancerecord {
  id                       Int                            @id @default(autoincrement())
  sessionId                Int
  studentId                Int
  status                   studentattendancerecord_status
  remarks                  String?
  createdAt                DateTime                       @default(now())
  updatedAt                DateTime
  studentattendancesession studentattendancesession       @relation(fields: [sessionId], references: [id], onDelete: Cascade, map: "StudentAttendanceRecord_sessionId_fkey")
  student                  student                        @relation(fields: [studentId], references: [id], onDelete: Cascade, map: "StudentAttendanceRecord_studentId_fkey")

  @@unique([sessionId, studentId], map: "StudentAttendanceRecord_sessionId_studentId_key")
  @@index([studentId], map: "StudentAttendanceRecord_studentId_idx")
}

model studentattendancesession {
  id                      Int                       @id @default(autoincrement())
  schoolId                Int
  classId                 Int
  sectionId               Int?
  attendanceDate          DateTime                  @db.Date
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime
  markedById              Int
  studentattendancerecord studentattendancerecord[]
  Renamedclass            Renamedclass              @relation(fields: [classId], references: [id], map: "StudentAttendanceSession_classId_fkey")
  user                    user                      @relation(fields: [markedById], references: [id], map: "StudentAttendanceSession_markedById_fkey")
  school                  school                    @relation(fields: [schoolId], references: [id], map: "StudentAttendanceSession_schoolId_fkey")
  section                 section?                  @relation(fields: [sectionId], references: [id], map: "StudentAttendanceSession_sectionId_fkey")

  @@unique([schoolId, classId, sectionId, attendanceDate], map: "StudentAttendanceSession_schoolId_classId_sectionId_attendan_key")
  @@index([classId], map: "StudentAttendanceSession_classId_fkey")
  @@index([markedById], map: "StudentAttendanceSession_markedById_fkey")
  @@index([schoolId, attendanceDate], map: "StudentAttendanceSession_schoolId_attendanceDate_idx")
  @@index([sectionId], map: "StudentAttendanceSession_sectionId_fkey")
}

model studentdiscount {
  id         Int                       @id @default(autoincrement())
  schoolId   Int
  studentId  Int
  feeHeadId  Int
  type       studentdiscount_type
  amount     Decimal                   @db.Decimal(10, 2)
  applyType  studentdiscount_applyType
  appliedOn  DateTime?
  startMonth Int?
  endMonth   Int?
  remarks    String?
  isActive   Boolean                   @default(true)
  createdAt  DateTime                  @default(now())
  updatedAt  DateTime
  feehead    feehead                   @relation(fields: [feeHeadId], references: [id], map: "StudentDiscount_feeHeadId_fkey")
  school     school                    @relation(fields: [schoolId], references: [id], map: "StudentDiscount_schoolId_fkey")
  student    student                   @relation(fields: [studentId], references: [id], map: "StudentDiscount_studentId_fkey")

  @@index([feeHeadId], map: "StudentDiscount_feeHeadId_idx")
  @@index([schoolId], map: "StudentDiscount_schoolId_idx")
  @@index([studentId], map: "StudentDiscount_studentId_idx")
}

model studentfee {
  id             Int               @id @default(autoincrement())
  invoiceNo      String?           @unique(map: "StudentFee_invoiceNo_key")
  schoolId       Int
  studentId      Int
  feeStructureId Int
  month          Int?
  year           Int?
  totalAmount    Decimal           @db.Decimal(10, 2)
  paidAmount     Decimal           @default(0.00) @db.Decimal(10, 2)
  dueAmount      Decimal           @db.Decimal(10, 2)
  lateFee        Decimal           @default(0.00) @db.Decimal(10, 2)
  discount       Decimal           @default(0.00) @db.Decimal(10, 2)
  isAdmissionFee Boolean           @default(false)
  status         studentfee_status @default(PENDING)
  dueDate        DateTime
  remarks        String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime
  payment        payment[]
  paymentreceipt paymentreceipt[]
  refund         refund[]
  feestructure   feestructure      @relation(fields: [feeStructureId], references: [id], map: "StudentFee_feeStructureId_fkey")
  school         school            @relation(fields: [schoolId], references: [id], map: "StudentFee_schoolId_fkey")
  student        student           @relation(fields: [studentId], references: [id], map: "StudentFee_studentId_fkey")
  studentfeeitem studentfeeitem[]

  @@unique([studentId, feeStructureId, month, year], map: "StudentFee_studentId_feeStructureId_month_year_key")
  @@index([feeStructureId], map: "StudentFee_feeStructureId_fkey")
  @@index([schoolId], map: "StudentFee_schoolId_idx")
  @@index([status], map: "StudentFee_status_idx")
  @@index([studentId], map: "StudentFee_studentId_idx")
}

model studentfeeitem {
  id           Int                      @id @default(autoincrement())
  studentFeeId Int
  feeHeadId    Int
  amount       Decimal                  @db.Decimal(10, 2)
  frequency    studentfeeitem_frequency
  createdAt    DateTime                 @default(now())
  feehead      feehead                  @relation(fields: [feeHeadId], references: [id], map: "StudentFeeItem_feeHeadId_fkey")
  studentfee   studentfee               @relation(fields: [studentFeeId], references: [id], onDelete: Cascade, map: "StudentFeeItem_studentFeeId_fkey")

  @@index([feeHeadId], map: "StudentFeeItem_feeHeadId_idx")
  @@index([studentFeeId], map: "StudentFeeItem_studentFeeId_idx")
}

model studentparent {
  studentId Int
  parentId  Int
  createdAt DateTime @default(now())
  parent    parent   @relation(fields: [parentId], references: [id], onDelete: Cascade, map: "StudentParent_parentId_fkey")
  student   student  @relation(fields: [studentId], references: [id], onDelete: Cascade, map: "StudentParent_studentId_fkey")

  @@id([studentId, parentId])
  @@index([parentId], map: "StudentParent_parentId_idx")
}

model studentscholarship {
  id            Int         @id @default(autoincrement())
  schoolId      Int
  studentId     Int
  isActive      Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime
  scholarshipId Int
  scholarship   scholarship @relation(fields: [scholarshipId], references: [id], map: "StudentScholarship_scholarshipId_fkey")
  school        school      @relation(fields: [schoolId], references: [id], map: "StudentScholarship_schoolId_fkey")
  student       student     @relation(fields: [studentId], references: [id], map: "StudentScholarship_studentId_fkey")

  @@unique([studentId, scholarshipId], map: "StudentScholarship_studentId_scholarshipId_key")
  @@index([scholarshipId], map: "StudentScholarship_scholarshipId_fkey")
  @@index([schoolId], map: "StudentScholarship_schoolId_fkey")
}

model subject {
  id             Int              @id @default(autoincrement())
  name           String
  code           String
  description    String?
  isActive       Boolean          @default(true)
  schoolId       Int
  createdAt      DateTime         @default(now())
  updatedAt      DateTime
  maxMarks       Int?
  passMarks      Int?
  examsubject    examsubject[]
  syllabus       syllabus[]
  teachersubject teachersubject[]
  timetable      timetable[]

  @@unique([code, schoolId], map: "Subject_code_schoolId_key")
}

model syllabus {
  id           Int           @id @default(autoincrement())
  subjectId    Int
  gradeId      Int?
  classId      Int?
  schoolId     Int
  description  String?
  type         syllabus_type @default(CORE)
  chapters     Json
  maxMarks     Int?
  passMarks    Int?
  isActive     Boolean       @default(true)
  isDeleted    Boolean       @default(false)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime
  Renamedclass Renamedclass? @relation(fields: [classId], references: [id], map: "Syllabus_classId_fkey")
  grade        grade?        @relation(fields: [gradeId], references: [id], map: "Syllabus_gradeId_fkey")
  subject      subject       @relation(fields: [subjectId], references: [id], map: "Syllabus_subjectId_fkey")

  @@unique([subjectId, gradeId, classId, schoolId], map: "Syllabus_subjectId_gradeId_classId_schoolId_key")
  @@index([classId], map: "Syllabus_classId_fkey")
  @@index([gradeId], map: "Syllabus_gradeId_fkey")
}

model teacher {
  id             Int              @id @default(autoincrement())
  userId         Int              @unique(map: "Teacher_userId_key")
  schoolId       Int
  createdAt      DateTime         @default(now())
  updatedAt      DateTime
  teacherCode    String           @unique(map: "Teacher_teacherCode_key")
  phone          String?
  joiningDate    DateTime?
  gender         String?
  qualification  String?
  classteacher   classteacher[]
  school         school           @relation(fields: [schoolId], references: [id], map: "Teacher_schoolId_fkey")
  user           user             @relation(fields: [userId], references: [id], map: "Teacher_userId_fkey")
  teachersubject teachersubject[]
  timetable      timetable[]

  @@index([schoolId], map: "Teacher_schoolId_fkey")
}

model teachersubject {
  id           Int          @id @default(autoincrement())
  teacherId    Int
  subjectId    Int
  classId      Int
  sectionId    Int
  Renamedclass Renamedclass @relation(fields: [classId], references: [id], map: "TeacherSubject_classId_fkey")
  section      section      @relation(fields: [sectionId], references: [id], map: "TeacherSubject_sectionId_fkey")
  subject      subject      @relation(fields: [subjectId], references: [id], map: "TeacherSubject_subjectId_fkey")
  teacher      teacher      @relation(fields: [teacherId], references: [id], map: "TeacherSubject_teacherId_fkey")

  @@index([classId], map: "TeacherSubject_classId_fkey")
  @@index([sectionId], map: "TeacherSubject_sectionId_fkey")
  @@index([subjectId], map: "TeacherSubject_subjectId_fkey")
  @@index([teacherId], map: "TeacherSubject_teacherId_fkey")
}

model timetable {
  id             Int          @id @default(autoincrement())
  schoolId       Int
  classId        Int
  sectionId      Int
  subjectId      Int
  teacherId      Int
  createdAt      DateTime     @default(now())
  updatedAt      DateTime
  periodId       Int
  academicYearId Int
  dayId          Int
  endTime        String
  startTime      String
  Renamedclass   Renamedclass @relation(fields: [classId], references: [id], map: "Timetable_classId_fkey")
  day            day          @relation(fields: [dayId], references: [id], map: "Timetable_dayId_fkey")
  period         period       @relation(fields: [periodId], references: [id], map: "Timetable_periodId_fkey")
  school         school       @relation(fields: [schoolId], references: [id], map: "Timetable_schoolId_fkey")
  section        section      @relation(fields: [sectionId], references: [id], map: "Timetable_sectionId_fkey")
  subject        subject      @relation(fields: [subjectId], references: [id], map: "Timetable_subjectId_fkey")
  teacher        teacher      @relation(fields: [teacherId], references: [id], map: "Timetable_teacherId_fkey")

  @@unique([sectionId, dayId, periodId, academicYearId], map: "Timetable_sectionId_dayId_periodId_academicYearId_key")
  @@unique([teacherId, dayId, periodId, academicYearId], map: "Timetable_teacherId_dayId_periodId_academicYearId_key")
  @@index([classId], map: "Timetable_classId_fkey")
  @@index([dayId], map: "Timetable_dayId_fkey")
  @@index([periodId], map: "Timetable_periodId_fkey")
  @@index([schoolId, academicYearId], map: "Timetable_schoolId_academicYearId_idx")
  @@index([subjectId], map: "Timetable_subjectId_fkey")
}

model token {
  id        Int        @id @default(autoincrement())
  userId    Int
  tokenHash String     @unique(map: "Token_tokenHash_key")
  type      token_type
  expiresAt DateTime
  isUsed    Boolean    @default(false)
  isRevoked Boolean    @default(false)
  userAgent String?
  ipAddress String?
  createdAt DateTime   @default(now())
  user      user       @relation(fields: [userId], references: [id], onDelete: Cascade, map: "Token_userId_fkey")

  @@index([userId, type], map: "Token_userId_type_idx")
}

model transaction {
  id        Int                @id @default(autoincrement())
  schoolId  Int
  amount    Float
  gateway   String
  reference String
  status    transaction_status
  createdAt DateTime           @default(now())
}

model transportroute {
  id                    Int                     @id @default(autoincrement())
  schoolId              Int
  name                  String
  pickupPoint           String?
  amount                Float
  isActive              Boolean                 @default(true)
  createdAt             DateTime                @default(now())
  updatedAt             DateTime
  studentacademicrecord studentacademicrecord[]
  school                school                  @relation(fields: [schoolId], references: [id], map: "TransportRoute_schoolId_fkey")

  @@unique([schoolId, name], map: "TransportRoute_schoolId_name_key")
}

model user {
  id                       Int                        @id @default(autoincrement())
  name                     String
  email                    String                     @unique(map: "User_email_key")
  password                 String
  isActive                 Boolean                    @default(true)
  emailVerified            Boolean                    @default(false)
  schoolId                 Int?
  createdAt                DateTime                   @default(now())
  updatedAt                DateTime
  isDeleted                Boolean                    @default(false)
  employeeattendance       employeeattendance[]
  parent                   parent?
  payment                  payment[]
  paymentreceipt           paymentreceipt[]
  refund                   refund[]
  student                  student?
  studentattendancesession studentattendancesession[]
  teacher                  teacher?
  token                    token[]
  school                   school?                    @relation(fields: [schoolId], references: [id], map: "User_schoolId_fkey")
  userpermission           userpermission[]
  userrole                 userrole[]

  @@index([schoolId], map: "User_schoolId_fkey")
}

model userpermission {
  id           Int        @id @default(autoincrement())
  userId       Int
  permissionId Int
  granted      Boolean    @default(true)
  permission   permission @relation(fields: [permissionId], references: [id], map: "UserPermission_permissionId_fkey")
  user         user       @relation(fields: [userId], references: [id], map: "UserPermission_userId_fkey")

  @@unique([userId, permissionId], map: "UserPermission_userId_permissionId_key")
  @@index([permissionId], map: "UserPermission_permissionId_fkey")
}

model userrole {
  userId Int
  roleId Int
  role   role @relation(fields: [roleId], references: [id], map: "UserRole_roleId_fkey")
  user   user @relation(fields: [userId], references: [id], map: "UserRole_userId_fkey")

  @@id([userId, roleId])
  @@index([roleId], map: "UserRole_roleId_fkey")
}

