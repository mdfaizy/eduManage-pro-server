model Report {
  id          Int        @id @default(autoincrement())
  schoolId    Int
  title       String
  type        ReportType
  filePath    String?
  generatedBy Int
  createdAt   DateTime   @default(now())

  school School @relation(fields: [schoolId], references: [id])
  user   User   @relation(fields: [generatedBy], references: [id])

  @@index([schoolId])
}

///////////////////////////////////////////////////////////////
// 🎓 SCHOLARSHIP
///////////////////////////////////////////////////////////////

model Scholarship {
  id Int @id @default(autoincrement())

  /////////////////////////////////////////////////////////////

  schoolId Int

  name String

  type ScholarshipType

  amount Float

  description String?

  isActive Boolean @default(true)

  /////////////////////////////////////////////////////////////
  // RELATIONS
  /////////////////////////////////////////////////////////////

  school School @relation(fields: [schoolId], references: [id])

  studentScholarships StudentScholarship[]

  /////////////////////////////////////////////////////////////

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@unique([schoolId, name])
  @@index([schoolId])
}

///////////////////////////////////////////////////////////////
// 🎓 STUDENT SCHOLARSHIP
///////////////////////////////////////////////////////////////

model StudentScholarship {
  id Int @id @default(autoincrement())

  schoolId Int

  studentId Int

  scholarshipId Int

  isActive Boolean @default(true)

  /////////////////////////////////////////////////////////////
  // RELATIONS
  /////////////////////////////////////////////////////////////

  school School @relation(fields: [schoolId], references: [id])

  student Student @relation(fields: [studentId], references: [id])

  scholarship Scholarship @relation(fields: [scholarshipId], references: [id])

  /////////////////////////////////////////////////////////////

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@unique([studentId, scholarshipId])
  @@index([schoolId])
  @@index([studentId])
}

///////////////////////////////////////////////////////////////
// 💸 STUDENT DISCOUNT
///////////////////////////////////////////////////////////////

model StudentDiscount {
  id Int @id @default(autoincrement())

  schoolId Int

  studentId Int

  feeHeadId Int

  /////////////////////////////////////////////////////////////

  type DiscountType

  amount Decimal @db.Decimal(10, 2)

  applyType DiscountApplyType

  appliedOn DateTime?

  startMonth Int?

  endMonth Int?

  remarks String?

  isActive Boolean @default(true)

  /////////////////////////////////////////////////////////////
  // RELATIONS
  /////////////////////////////////////////////////////////////

  school School @relation(fields: [schoolId], references: [id])

  student Student @relation(fields: [studentId], references: [id])

  feeHead FeeHead @relation(fields: [feeHeadId], references: [id])

  /////////////////////////////////////////////////////////////

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@index([schoolId])
  @@index([studentId])
  @@index([feeHeadId])
}

///////////////////////////////////////////////////////////////
// 🚌 TRANSPORT ROUTE
///////////////////////////////////////////////////////////////
model TransportRoute {
  id          Int     @id @default(autoincrement())
  schoolId    Int
  name        String
  pickupPoint String?

  amount Float

  isActive Boolean @default(true)

  /////////////////////////////////////////////////////////////
  // RELATIONS
  /////////////////////////////////////////////////////////////

  school School @relation(fields: [schoolId], references: [id])

  studentAcademicRecords StudentAcademicRecord[]

  /////////////////////////////////////////////////////////////

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@unique([schoolId, name])
  @@index([schoolId])
}

///////////////////////////////////////////////////////////////
// 📚 BOOK PACKAGE
///////////////////////////////////////////////////////////////

model BookPackage {
  id Int @id @default(autoincrement())

  schoolId Int

  classId Int

  name String

  amount Float

  isActive Boolean @default(true)

  /////////////////////////////////////////////////////////////
  // RELATIONS
  /////////////////////////////////////////////////////////////

  school School @relation(fields: [schoolId], references: [id])

  class Class @relation(fields: [classId], references: [id])

  /////////////////////////////////////////////////////////////

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@unique([schoolId, classId, name])
  @@index([schoolId])
  @@index([classId])
}

model FeeRefund {
  id Int @id @default(autoincrement())

  schoolId     Int
  studentId    Int
  studentFeeId Int

  refundNo String @unique

  amount Decimal @db.Decimal(10, 2)

  refundMethod String
  reason       String?

  status String @default("COMPLETED")

  createdBy Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  studentFee StudentFee @relation("StudentFeeFeeRefunds", fields: [studentFeeId], references: [id])
}

model LateFeeWaiver {
  id           Int      @id @default(autoincrement())
  schoolId     Int
  studentFeeId Int
  amount       Decimal  @db.Decimal(10, 2)
  reason       String
  waivedBy     Int
  waivedAt     DateTime @default(now())

  school     School     @relation(fields: [schoolId], references: [id])
  studentFee StudentFee @relation(fields: [studentFeeId], references: [id])
  user       User       @relation(fields: [waivedBy], references: [id])
}
