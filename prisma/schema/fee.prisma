///////////////////////////////////////////////////////////////
// 💰 FEE MODULE
///////////////////////////////////////////////////////////////

///////////////////////////////////////////////////////////////
// FEE HEAD
///////////////////////////////////////////////////////////////
model FeeHead {
  id Int @id @default(autoincrement())

  /////////////////////////////////////////////////////////////
  // BASIC INFORMATION
  /////////////////////////////////////////////////////////////

  schoolId Int

  name String

  description String?

  isOptional Boolean @default(false)

  frequency DiscountApplyType @default(MONTHLY)
  isActive  Boolean           @default(true)

  /////////////////////////////////////////////////////////////
  // RELATIONS
  /////////////////////////////////////////////////////////////

  school School @relation(fields: [schoolId], references: [id])

  feeStructureItems FeeStructureItem[]

  studentFeeItems StudentFeeItem[]

  studentDiscounts StudentDiscount[]

  /////////////////////////////////////////////////////////////

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  /////////////////////////////////////////////////////////////

  @@unique([schoolId, name])
  @@index([schoolId])
}

///////////////////////////////////////////////////////////////
// FEE STRUCTURE
///////////////////////////////////////////////////////////////

model FeeStructure {
  id Int @id @default(autoincrement())

  /////////////////////////////////////////////////////////////
  // BASIC INFORMATION
  /////////////////////////////////////////////////////////////

  schoolId Int

  academicYearId Int

  classId Int

  name String

  /////////////////////////////////////////////////////////////
  // FEES
  /////////////////////////////////////////////////////////////

  monthlyFee Float @default(0)

  yearlyFee Float @default(0)

  oneTimeFee Float @default(0)

  dueDay Int

  isActive Boolean @default(true)

  /////////////////////////////////////////////////////////////
  // RELATIONS
  /////////////////////////////////////////////////////////////

  school School @relation(fields: [schoolId], references: [id])

  academicYear AcademicYear @relation(fields: [academicYearId], references: [id])

  class Class @relation(fields: [classId], references: [id])

  items FeeStructureItem[]

  studentFees StudentFee[]

  /////////////////////////////////////////////////////////////

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  /////////////////////////////////////////////////////////////

  @@unique([schoolId, academicYearId, classId])
  @@index([schoolId])
  @@index([classId])
  @@index([academicYearId])
}

///////////////////////////////////////////////////////////////
// FEE STRUCTURE ITEM
///////////////////////////////////////////////////////////////

model FeeStructureItem {
  id Int @id @default(autoincrement())

  /////////////////////////////////////////////////////////////

  feeStructureId Int

  feeHeadId Int

  amount Decimal @db.Decimal(10, 2)

  frequency FeeFrequency

  /////////////////////////////////////////////////////////////
  // RELATIONS
  /////////////////////////////////////////////////////////////

  feeStructure FeeStructure @relation(fields: [feeStructureId], references: [id], onDelete: Cascade)

  feeHead FeeHead @relation(fields: [feeHeadId], references: [id])

  /////////////////////////////////////////////////////////////

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  /////////////////////////////////////////////////////////////

  @@unique([feeStructureId, feeHeadId])
  @@index([feeStructureId])
  @@index([feeHeadId])
}

///////////////////////////////////////////////////////////////
// FEE FREQUENCY
///////////////////////////////////////////////////////////////

///////////////////////////////////////////////////////////////
// 🧾 STUDENT FEE
///////////////////////////////////////////////////////////////

model StudentFee {
  id Int @id @default(autoincrement())

  /////////////////////////////////////////////////////////////
  // BASIC INFORMATION
  /////////////////////////////////////////////////////////////

  invoiceNo String? @unique

  schoolId Int

  studentId Int

  feeStructureId Int

  month Int?

  year Int?

  /////////////////////////////////////////////////////////////
  // AMOUNT
  /////////////////////////////////////////////////////////////

  totalAmount Decimal @db.Decimal(10, 2)

  paidAmount Decimal @default(0) @db.Decimal(10, 2)

  dueAmount Decimal @db.Decimal(10, 2)

  lateFee Decimal @default(0) @db.Decimal(10, 2)

  discount Decimal @default(0) @db.Decimal(10, 2)

  /////////////////////////////////////////////////////////////

  isAdmissionFee Boolean @default(false)

  status FeeStatus @default(PENDING)

  dueDate DateTime

  remarks String?

  /////////////////////////////////////////////////////////////
  // RELATIONS
  /////////////////////////////////////////////////////////////

  school School @relation(fields: [schoolId], references: [id])

  student Student @relation(fields: [studentId], references: [id])

  feeStructure FeeStructure @relation(fields: [feeStructureId], references: [id])

  items StudentFeeItem[]

  // receipts PaymentReceipt[]

  payments Payment[]
  receipts PaymentReceipt[]
  // refunds   Refund[]
  refunds  Refund[]         @relation("StudentFeeRefunds")

  feeRefunds FeeRefund[] @relation("StudentFeeFeeRefunds")

  // feeRefunds FeeRefund[] @relation("StudentFeeFeeRefunds")
  lateFeeWaivers LateFeeWaiver[]
  /////////////////////////////////////////////////////////////

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  /////////////////////////////////////////////////////////////

  @@unique([studentId, feeStructureId, month, year])
  @@index([studentId])
  @@index([schoolId])
  @@index([status])
}

///////////////////////////////////////////////////////////////
// 🧾 STUDENT FEE ITEM
///////////////////////////////////////////////////////////////

model StudentFeeItem {
  id Int @id @default(autoincrement())

  studentFeeId Int

  feeHeadId Int

  amount Decimal @db.Decimal(10, 2)

  frequency FeeFrequency

  /////////////////////////////////////////////////////////////
  // RELATIONS
  /////////////////////////////////////////////////////////////

  studentFee StudentFee @relation(fields: [studentFeeId], references: [id], onDelete: Cascade)

  feeHead FeeHead @relation(fields: [feeHeadId], references: [id])

  /////////////////////////////////////////////////////////////

  createdAt DateTime @default(now())

  /////////////////////////////////////////////////////////////

  @@index([studentFeeId])
  @@index([feeHeadId])
}

