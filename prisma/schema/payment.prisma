model Refund {
  id Int @id @default(autoincrement())

  schoolId     Int
  studentId    Int
  studentFeeId Int
  paymentId    Int

  amount Decimal @db.Decimal(12, 2)

  reason String @db.Text

  refundMethod PaymentMethod

  status RefundStatus @default(PENDING)

  transactionId String? @db.VarChar(150)

  refundedBy Int?

  refundDate DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  school School @relation(fields: [schoolId], references: [id])

  student Student @relation(fields: [studentId], references: [id])

  // IMPORTANT:
  // Named relation because StudentFee also has FeeRefund relation
  studentFee StudentFee @relation("StudentFeeRefunds", fields: [studentFeeId], references: [id])

  payment Payment @relation(fields: [paymentId], references: [id])

  refundedUser User? @relation("RefundProcessedBy", fields: [refundedBy], references: [id])

  @@index([schoolId])
  @@index([studentId])
  @@index([studentFeeId])
  @@index([paymentId])
  @@index([status])
  @@index([refundDate])
}

// =====================================================
// REFUND STATUS
// =====================================================

enum RefundStatus {
  PENDING
  APPROVED
  COMPLETED
  REJECTED
  CANCELLED
}

enum PaymentReceiptStatus {
  SUCCESS
  FAILED
  PENDING
}
