// =====================================================
// PAYMENT
// =====================================================

model Payment {
  id Int @id @default(autoincrement())

  schoolId     Int
  studentId    Int
  studentFeeId Int

  // Payment
  amount        Decimal                  @db.Decimal(12, 2)
  paymentMethod PaymentMethod
  status        PaymentTransactionStatus @default(SUCCESS)

  // Gateway / transaction
  transactionId String? @db.VarChar(150)
  referenceNo   String? @db.VarChar(150)

  // Payment date
  paymentDate DateTime @default(now())

  // Remarks
  remarks String? @db.Text

  // Audit
  collectedBy Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  school     School     @relation(fields: [schoolId], references: [id])
  student    Student    @relation(fields: [studentId], references: [id])
  studentFee StudentFee @relation(fields: [studentFeeId], references: [id])

  collector User? @relation("PaymentCollectedBy", fields: [collectedBy], references: [id])

  receipts PaymentReceipt[]
  refunds  Refund[]

  @@index([schoolId])
  @@index([studentId])
  @@index([studentFeeId])
  @@index([transactionId])
  @@index([paymentDate])
  @@index([status])
}

