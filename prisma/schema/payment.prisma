model PaymentReceipt {
  id Int @id @default(autoincrement())

  schoolId     Int
  studentId    Int?
  studentFeeId Int
  paymentId    Int?

  receiptNo String  @unique @db.VarChar(191)
  amount    Decimal @db.Decimal(12, 2)

  paymentDate DateTime @default(now())
  issuedAt    DateTime @default(now())

  paymentMethod PaymentMethod

  transactionId String? @db.VarChar(191)
  remarks       String? @db.VarChar(191)

  receivedById Int?

  status PaymentReceiptStatus @default(SUCCESS)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school     School     @relation(fields: [schoolId], references: [id])
  student    Student?   @relation(fields: [studentId], references: [id])
  studentFee StudentFee @relation(fields: [studentFeeId], references: [id])
  payment    Payment?   @relation(fields: [paymentId], references: [id])

  receivedBy User? @relation("PaymentReceiptReceivedBy", fields: [receivedById], references: [id])

  @@index([schoolId])
  @@index([studentId])
  @@index([studentFeeId])
  @@index([paymentId])
  @@index([receivedById])
  @@index([paymentDate])
  @@index([issuedAt])
}

