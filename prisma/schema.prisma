generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

/////////////////////////////
// 🔓 PUBLIC / SYSTEM LEVEL
/////////////////////////////



/////////////////////////////
// 🔐 AUTH & RBAC
/////////////////////////////

model Teacher {
  id              Int              @id @default(autoincrement())
  userId          Int
  schoolId        Int
  teacherCode     String           @unique
  phone           String?
  gender          String?
  joiningDate     DateTime?
  qualification   String?
  user            User             @relation(fields: [userId], references: [id])
  school          School           @relation(fields: [schoolId], references: [id])
  classTeachers   ClassTeacher[]
  teacherSubjects TeacherSubject[]

  timetables Timetable[]
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@unique([userId])
}


/////////////////////////////
// 🎓 ACADEMIC
/////////////////////////////
model Class {
  id Int @id @default(autoincrement())

  // =========================================
  // BASIC INFO
  // =========================================

  name String

  description String?

  schoolId Int

  school School @relation(fields: [schoolId], references: [id])

  // =========================================
  // CLASS SETTINGS
  // =========================================

  maxStudents Int?

  isActive Boolean @default(true)

  isDeleted Boolean @default(false)

  // =========================================
  // RELATIONS
  // =========================================

  sections Section[]

  syllabi Syllabus[]

  exams Exam[]

  classTeachers ClassTeacher[]

  teacherSubjects TeacherSubject[]

  timetables Timetable[]

  admissions Admission[]

  feeStructures FeeStructure[]

  academicRecords StudentAcademicRecord[]

  studentAttendanceSessions StudentAttendanceSession[]
  bookPackages              BookPackage[]

  // =========================================
  // AUDIT
  // =========================================

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  // =========================================
  // INDEXES
  // =========================================

  @@unique([name, schoolId])
  @@index([schoolId])
  @@index([isActive])
  @@index([isDeleted])
}

model Section {
  id Int @id @default(autoincrement())

  name String

  classId Int

  schoolId Int

  capacity Int?

  description String?

  isActive Boolean @default(true)

  class Class @relation(fields: [classId], references: [id])

  school                    School                     @relation(fields: [schoolId], references: [id])
  studentAttendanceSessions StudentAttendanceSession[]
  classTeachers             ClassTeacher[]

  teacherSubjects TeacherSubject[]

  timetables Timetable[]

  admissions      Admission[]
  exams           Exam[]
  academicRecords StudentAcademicRecord[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@unique([schoolId, name, classId])
}

model Grade {
  id          Int        @id @default(autoincrement())
  name        String
  schoolId    Int
  description String?
  isActive    Boolean    @default(true)
  isDeleted   Boolean    @default(false)
  syllabi     Syllabus[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@unique([name, schoolId])
}

model Subject {
  id              Int              @id @default(autoincrement())
  name            String
  description     String?
  isActive        Boolean          @default(true)
  schoolId        Int
  code            String
  maxMarks        Int? // ✅ ADD
  passMarks       Int?
  syllabi         Syllabus[]
  teacherSubjects TeacherSubject[]
  examSubjects    ExamSubject[]
  timetables      Timetable[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@unique([code, schoolId])
}

model Syllabus {
  id          Int         @id @default(autoincrement())
  subjectId   Int
  gradeId     Int?
  classId     Int?
  schoolId    Int
  description String?
  type        SubjectType @default(CORE)
  chapters    Json
  maxMarks    Int?
  passMarks   Int?
  isActive    Boolean     @default(true)
  isDeleted   Boolean     @default(false)
  subject     Subject     @relation(fields: [subjectId], references: [id])
  grade       Grade?      @relation(fields: [gradeId], references: [id])
  class       Class?      @relation(fields: [classId], references: [id])
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@unique([subjectId, gradeId, classId, schoolId])
}

enum SubjectType {
  CORE
  EXTRA
  THEORY
  PRACTICAL
  BOTH
}

model ClassTeacher {
  id Int @id @default(autoincrement())

  teacherId Int
  classId   Int
  sectionId Int

  teacher Teacher @relation(fields: [teacherId], references: [id])
  class   Class   @relation(fields: [classId], references: [id])
  section Section @relation(fields: [sectionId], references: [id])

  createdAt DateTime @default(now())

  // ⭐ ek class + section ka sirf 1 class teacher
  @@unique([classId, sectionId])
}

model Day {
  id         Int         @id @default(autoincrement())
  schoolId   Int
  name       String
  shortName  String
  order      Int
  maxPeriods Int
  isActive   Boolean     @default(true)
  isHalfDay  Boolean     @default(false)
  timetables Timetable[]

  school  School   @relation(fields: [schoolId], references: [id])
  periods Period[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([schoolId, name])
}

model TeacherSubject {
  id Int @id @default(autoincrement())

  teacherId Int
  subjectId Int
  classId   Int
  sectionId Int
  // schoolId Int

  teacher Teacher @relation(fields: [teacherId], references: [id])
  subject Subject @relation(fields: [subjectId], references: [id])
  class   Class   @relation(fields: [classId], references: [id])
  section Section @relation(fields: [sectionId], references: [id])

  // ⭐ same subject same class same section duplicate nahi
  // @@unique([teacherId, subjectId, classId, sectionId])
  // @@unique([schoolId, teacherId, subjectId, classId, sectionId])
}

model SchoolTiming {
  id           Int    @id @default(autoincrement())
  schoolId     Int
  academicYear String

  type TimingType @default(REGULAR)

  school School @relation(fields: [schoolId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([schoolId, academicYear, type])
}

enum TimingType {
  REGULAR
  WINTER
  RAMADAN
  EXAM
}

model Period {
  id             Int        @id @default(autoincrement())
  schoolId       Int
  academicYearId Int
  timingType     TimingType @default(REGULAR)

  dayId        Int
  periodNumber Int

  startTime String
  endTime   String

  isBreak  Boolean @default(false)
  isActive Boolean @default(true)

  school     School      @relation(fields: [schoolId], references: [id])
  day        Day         @relation(fields: [dayId], references: [id])
  timetables Timetable[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([schoolId, academicYearId, dayId, periodNumber])
  @@index([schoolId, academicYearId])
}

model AcademicYear {
  id Int @id @default(autoincrement())

  schoolId Int

  name String

  startDate DateTime?

  endDate DateTime?

  isActive Boolean @default(true)

  school School @relation(fields: [schoolId], references: [id])

  admissions      Admission[]
  exams           Exam[]
  academicRecords StudentAcademicRecord[]
  feeStructures   FeeStructure[]
  createdAt       DateTime                @default(now())

  updatedAt DateTime @updatedAt
}

model Timetable {
  id Int @id @default(autoincrement())

  schoolId  Int
  classId   Int
  sectionId Int
  subjectId Int
  teacherId Int

  dayId          Int
  periodId       Int
  academicYearId Int

  startTime String
  endTime   String
  //   effectiveFrom DateTime
  // effectiveTo   DateTime?

  school  School  @relation(fields: [schoolId], references: [id])
  class   Class   @relation(fields: [classId], references: [id])
  section Section @relation(fields: [sectionId], references: [id])
  subject Subject @relation(fields: [subjectId], references: [id])
  teacher Teacher @relation(fields: [teacherId], references: [id])
  period  Period  @relation(fields: [periodId], references: [id])
  day     Day     @relation(fields: [dayId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  //   @@unique([schoolId, sectionId, dayId, periodId, academicYearId, effectiveFrom])
  // @@unique([schoolId, teacherId, dayId, periodId, academicYearId, effectiveFrom])

  @@unique([sectionId, dayId, periodId, academicYearId])
  @@unique([teacherId, dayId, periodId, academicYearId])
  @@index([schoolId, academicYearId])
}

