model Refund {
  id Int @id @default(autoincrement())

  schoolId     Int
  studentId    Int
  studentFeeId Int
  paymentId    Int

  amount Decimal @db.Decimal(12, 2)

  reason String @db.Text

  refundMethod PaymentMethod

  status RefundStatus @default(PENDING)

  transactionId String? @db.VarChar(150)

  refundedBy Int?

  refundDate DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  school School @relation(fields: [schoolId], references: [id])

  student Student @relation(fields: [studentId], references: [id])

  // IMPORTANT:
  // Named relation because StudentFee also has FeeRefund relation
  studentFee StudentFee @relation("StudentFeeRefunds", fields: [studentFeeId], references: [id])

  payment Payment @relation(fields: [paymentId], references: [id])

  refundedUser User? @relation("RefundProcessedBy", fields: [refundedBy], references: [id])

  @@index([schoolId])
  @@index([studentId])
  @@index([studentFeeId])
  @@index([paymentId])
  @@index([status])
  @@index([refundDate])
}

// =====================================================
// REFUND STATUS
// =====================================================

enum RefundStatus {
  PENDING
  APPROVED
  COMPLETED
  REJECTED
  CANCELLED
}

enum PaymentReceiptStatus {
  SUCCESS
  FAILED
  PENDING
}

///////////////////////////////////////////////////////////////
// 🏫 SCHOOL
///////////////////////////////////////////////////////////////

model School {
  id Int @id @default(autoincrement())

  name  String
  email String  @unique
  phone String?

  status SchoolStatus @default(PENDING)

  /////////////////////////////////////////////////////////////
  // RELATIONS
  /////////////////////////////////////////////////////////////

  users User[]

  teachers Teacher[]

  students Student[]

  parents Parent[]

  classes Class[]

  sections Section[]

  academicYears AcademicYear[]

  admissions Admission[]

  periods Period[]

  days Day[]

  timings SchoolTiming[]

  timetables Timetable[]

  exams   Exam[]
  reports Report[]

  feeHeads FeeHead[]

  feeStructures FeeStructure[]

  studentFees StudentFee[]

  // paymentReceipts     PaymentReceipt[]
  payments        Payment[]
  paymentReceipts PaymentReceipt[]
  refunds         Refund[]

  scholarships Scholarship[]

  studentScholarships StudentScholarship[]

  studentDiscounts StudentDiscount[]

  transportRoutes TransportRoute[]

  bookPackages BookPackage[]

  subscriptions SchoolSubscription[]

  academicRecords StudentAcademicRecord[]

  studentAttendanceSessions StudentAttendanceSession[] @relation("SchoolStudentAttendanceSessions")

  employeeAttendances EmployeeAttendance[] @relation("SchoolEmployeeAttendances")
  lateFeeWaivers      LateFeeWaiver[]
  /////////////////////////////////////////////////////////////

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

///////////////////////////////////////////////////////////////
// SCHOOL STATUS
///////////////////////////////////////////////////////////////

enum SchoolStatus {
  PENDING
  ACTIVE
  BLOCKED
}

///////////////////////////////////////////////////////////////
// PLAN
///////////////////////////////////////////////////////////////

model Plan {
  id Int @id @default(autoincrement())

  name String @unique

  price Float

  duration Int

  features Json

  subscriptions SchoolSubscription[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

///////////////////////////////////////////////////////////////
// SUBSCRIPTION
///////////////////////////////////////////////////////////////

model SchoolSubscription {
  id Int @id @default(autoincrement())

  schoolId Int

  planId Int

  startDate DateTime

  endDate DateTime

  status SubscriptionStatus

  school School @relation(fields: [schoolId], references: [id])

  plan Plan @relation(fields: [planId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

///////////////////////////////////////////////////////////////

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

///////////////////////////////////////////////////////////////
// SCHOOL REQUEST
///////////////////////////////////////////////////////////////

model SchoolRequest {
  id Int @id @default(autoincrement())

  schoolName String

  email String

  phone String

  status RequestStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

///////////////////////////////////////////////////////////////

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

///////////////////////////////////////////////////////////////
// TRANSACTION
///////////////////////////////////////////////////////////////

model Transaction {
  id Int @id @default(autoincrement())

  schoolId Int

  amount Float

  gateway String

  reference String

  status PaymentStatus

  createdAt DateTime @default(now())
}

///////////////////////////////////////////////////////////////

enum PaymentStatus {
  SUCCESS
  FAILED
  PENDING
}

///////////////////////////////////////////////////////////////
// 👨‍🎓 STUDENT MODULE
///////////////////////////////////////////////////////////////
model Student {
  id Int @id @default(autoincrement())
  /////////////////////////////////////////////////////////////
  // BASIC INFORMATION
  /////////////////////////////////////////////////////////////

  schoolId Int

  userId Int? @unique

  name String

  profilePhoto String?

  studentCode String @unique

  dob DateTime?

  gender Gender?

  address String?

  phoneNumber String?

  email String?

  /////////////////////////////////////////////////////////////
  // STATUS
  /////////////////////////////////////////////////////////////

  isActive Boolean @default(true)

  isDeleted Boolean @default(false)

  /////////////////////////////////////////////////////////////
  // RELATIONS
  /////////////////////////////////////////////////////////////

  school School @relation(fields: [schoolId], references: [id])

  user User? @relation(fields: [userId], references: [id])

  admissions Admission[]

  academicRecords StudentAcademicRecord[]

  attendanceRecords StudentAttendanceRecord[]

  examMarks ExamMark[]

  studentFees StudentFee[]

  payments        Payment[]
  paymentReceipts PaymentReceipt[]
  refunds         Refund[]

  studentScholarships StudentScholarship[]

  studentDiscounts StudentDiscount[]

  parents StudentParent[]

  lateFee       Decimal @default(0) @db.Decimal(10, 2)
  lateFeeWaived Decimal @default(0) @db.Decimal(10, 2)

  // lateFeeWaivers LateFeeWaiver[]
  /////////////////////////////////////////////////////////////

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@index([schoolId])
}

///////////////////////////////////////////////////////////////

model StudentAcademicRecord {
  id Int @id @default(autoincrement())

  /////////////////////////////////////////////////////////////

  schoolId Int

  studentId Int

  academicYearId Int

  classId Int

  sectionId Int?

  transportRouteId Int?

  /////////////////////////////////////////////////////////////

  rollNumber Int

  admissionNo String

  /////////////////////////////////////////////////////////////

  isCurrent Boolean @default(true)

  status AcademicRecordStatus @default(ACTIVE)

  /////////////////////////////////////////////////////////////

  promotedFromId Int?

  /////////////////////////////////////////////////////////////
  // RELATIONS
  /////////////////////////////////////////////////////////////

  school School @relation(fields: [schoolId], references: [id])

  student Student @relation(fields: [studentId], references: [id])

  academicYear AcademicYear @relation(fields: [academicYearId], references: [id])

  class Class @relation(fields: [classId], references: [id])

  section Section? @relation(fields: [sectionId], references: [id])

  transportRoute TransportRoute? @relation(fields: [transportRouteId], references: [id])

  promotedFrom StudentAcademicRecord? @relation("PromotionHistory", fields: [promotedFromId], references: [id])

  promotedTo StudentAcademicRecord[] @relation("PromotionHistory")

  /////////////////////////////////////////////////////////////

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  /////////////////////////////////////////////////////////////

  @@index([schoolId])
  @@index([studentId])
  @@index([academicYearId])
}

///////////////////////////////////////////////////////////////

model Admission {
  id Int @id @default(autoincrement())

  /////////////////////////////////////////////////////////////

  schoolId Int

  studentId Int?

  /////////////////////////////////////////////////////////////

  studentName String

  dob DateTime?

  gender Gender?

  /////////////////////////////////////////////////////////////

  address String?

  phoneNumber String?

  email String?

  /////////////////////////////////////////////////////////////

  classId Int

  sectionId Int?

  academicYearId Int

  /////////////////////////////////////////////////////////////

  previousSchool String?

  previousClass String?

  previousPercentage Float?

  /////////////////////////////////////////////////////////////

  rollNumber Int?

  admissionNo String?

  /////////////////////////////////////////////////////////////

  bloodGroup String?

  nationality String?

  religion String?

  caste String?

  aadharNumber String?

  /////////////////////////////////////////////////////////////
  // FATHER
  /////////////////////////////////////////////////////////////

  fatherName String?

  fatherPhone String?

  fatherEmail String?

  fatherOccupation String?

  /////////////////////////////////////////////////////////////
  // MOTHER
  /////////////////////////////////////////////////////////////

  motherName String?

  motherPhone String?

  motherEmail String?

  motherOccupation String?

  /////////////////////////////////////////////////////////////
  // GUARDIAN
  /////////////////////////////////////////////////////////////

  guardianName String?

  guardianRelation String?

  guardianPhone String?

  guardianEmail String?

  /////////////////////////////////////////////////////////////

  admissionType AdmissionType @default(NEW)

  status AdmissionStatus @default(PENDING)

  admissionDate DateTime? @default(now())

  approvedAt DateTime?

  /////////////////////////////////////////////////////////////

  medium String?

  previousBoard String?

  tcNumber String?

  /////////////////////////////////////////////////////////////
  // RELATIONS
  /////////////////////////////////////////////////////////////

  school School @relation(fields: [schoolId], references: [id])

  student Student? @relation(fields: [studentId], references: [id])

  class Class @relation(fields: [classId], references: [id])

  section Section? @relation(fields: [sectionId], references: [id])

  academicYear AcademicYear @relation(fields: [academicYearId], references: [id])

  /////////////////////////////////////////////////////////////

  createdAt DateTime @default(now())

  @@index([schoolId])
}

///////////////////////////////////////////////////////////////

model StudentParent {
  studentId Int

  parentId Int

  /////////////////////////////////////////////////////////////

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  parent Parent @relation(fields: [parentId], references: [id], onDelete: Cascade)

  /////////////////////////////////////////////////////////////

  createdAt DateTime @default(now())

  /////////////////////////////////////////////////////////////

  @@id([studentId, parentId])
  @@index([parentId])
}

///////////////////////////////////////////////////////////////

enum AcademicRecordStatus {
  ACTIVE
  PROMOTED
  REVERTED
  TRANSFERRED
  COMPLETED
  DROPPED
}

///////////////////////////////////////////////////////////////

enum AdmissionType {
  NEW
  TRANSFER
  READMISSION
}

///////////////////////////////////////////////////////////////

enum AdmissionStatus {
  PENDING
  APPROVED
  ACTIVE
  CANCELLED
  TRANSFERRED
  COMPLETED
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

model Parent {
  id       Int @id @default(autoincrement())
  userId   Int @unique
  schoolId Int

  fatherName       String?
  fatherPhone      String?
  fatherEmail      String?
  fatherOccupation String?

  motherName       String?
  motherPhone      String?
  motherEmail      String?
  motherOccupation String?

  guardianName     String?
  guardianRelation String?
  guardianPhone    String?
  // ✅ Relations
  user             User    @relation(fields: [userId], references: [id])
  school           School  @relation(fields: [schoolId], references: [id])

  students StudentParent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId])
}

model Teacher {
  id              Int              @id @default(autoincrement())
  userId          Int
  schoolId        Int
  teacherCode     String           @unique
  phone           String?
  gender          String?
  joiningDate     DateTime?
  qualification   String?
  user            User             @relation(fields: [userId], references: [id])
  school          School           @relation(fields: [schoolId], references: [id])
  classTeachers   ClassTeacher[]
  teacherSubjects TeacherSubject[]

  timetables Timetable[]
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@unique([userId])
}

model Staff {
  id            Int @id @default(autoincrement())
  userId        Int
  schoolId      Int
  designationId Int
}

model Designation {
  id   Int    @id @default(autoincrement())
  name String
}

model Payroll {
  id      Int    @id @default(autoincrement())
  staffId Int
  salary  Float
  month   String
}

