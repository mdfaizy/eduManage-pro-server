generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

/////////////////////////////
// 🔓 PUBLIC / SYSTEM LEVEL
/////////////////////////////

model School {
  id                  Int                  @id @default(autoincrement())
  name                String
  email               String               @unique
  phone               String?
  status              SchoolStatus         @default(PENDING)
  sections            Section[]
  subscriptions       SchoolSubscription[]
  users               User[]
  teachers            Teacher[]
  timetables          Timetable[]
  timings             SchoolTiming[]
  periods             Period[]
  days                Day[]
  parents             Parent[]
  academicYears       AcademicYear[]
  students            Student[]
  admissions          Admission[]
  exams               Exam[]
  classes             Class[]
  feeHeads            FeeHead[]
  studentScholarships StudentScholarship[]

  transportRoutes TransportRoute[]

  bookPackages BookPackage[]

  feeStructures FeeStructure[]

  studentFees StudentFee[]

  paymentReceipts PaymentReceipt[]
  academicRecords StudentAcademicRecord[]

  studentAttendanceSessions StudentAttendanceSession[] @relation("SchoolStudentAttendanceSessions")

  employeeAttendances EmployeeAttendance[] @relation("SchoolEmployeeAttendances")
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  scholarships        Scholarship[]
}

enum SchoolStatus {
  PENDING
  ACTIVE
  BLOCKED
}

model Plan {
  id       Int    @id @default(autoincrement())
  name     String @unique
  price    Float
  duration Int // days
  features Json // ["ATTENDANCE","FEES","EXAMS"]

  subscriptions SchoolSubscription[]
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
}

model SchoolSubscription {
  id        Int                @id @default(autoincrement())
  schoolId  Int
  planId    Int
  startDate DateTime
  endDate   DateTime
  status    SubscriptionStatus

  school    School   @relation(fields: [schoolId], references: [id])
  plan      Plan     @relation(fields: [planId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

model SchoolRequest {
  id         Int           @id @default(autoincrement())
  schoolName String
  email      String
  phone      String
  status     RequestStatus @default(PENDING)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model Transaction {
  id        Int           @id @default(autoincrement())
  schoolId  Int
  amount    Float
  gateway   String
  reference String
  status    PaymentStatus
  createdAt DateTime      @default(now())
}

enum PaymentStatus {
  SUCCESS
  FAILED
  PENDING
}

/////////////////////////////
// 🔐 AUTH & RBAC
/////////////////////////////

model User {
  id            Int     @id @default(autoincrement())
  name          String
  email         String  @unique
  password      String
  isActive      Boolean @default(true)
  isDeleted     Boolean @default(false)
  emailVerified Boolean @default(false)

  schoolId                  Int?
  school                    School?                    @relation(fields: [schoolId], references: [id])
  markedAttendances         StudentAttendanceSession[]
  employeeAttendanceRecords EmployeeAttendance[]
  roles                     UserRole[]
  tokens                    Token[]
  teacher                   Teacher?
  student                   Student?
  parent                    Parent?
  userPermissions           UserPermission[]
  paymentReceipts           PaymentReceipt[]
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt
}

model Teacher {
  id              Int              @id @default(autoincrement())
  userId          Int
  schoolId        Int
  teacherCode     String           @unique
  phone           String?
  gender          String?
  joiningDate     DateTime?
  qualification   String?
  user            User             @relation(fields: [userId], references: [id])
  school          School           @relation(fields: [schoolId], references: [id])
  classTeachers   ClassTeacher[]
  teacherSubjects TeacherSubject[]

  timetables Timetable[]
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@unique([userId])
}

model Role {
  id          Int              @id @default(autoincrement())
  name        String
  schoolId    Int?
  profileType String?
  users       UserRole[]
  permissions RolePermission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([name, schoolId])
}

model Permission {
  id              Int              @id @default(autoincrement())
  key             String           @unique
  description     String?
  roles           RolePermission[]
  userPermissions UserPermission[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model UserRole {
  userId Int
  roleId Int

  user User @relation(fields: [userId], references: [id])
  role Role @relation(fields: [roleId], references: [id])

  @@id([userId, roleId])
}

model UserPermission {
  id           Int     @id @default(autoincrement())
  userId       Int
  permissionId Int
  granted      Boolean @default(true)

  user       User       @relation(fields: [userId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@unique([userId, permissionId])
}

model RolePermission {
  roleId       Int
  permissionId Int

  role       Role       @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
}

model Token {
  id        Int       @id @default(autoincrement())
  userId    Int
  tokenHash String    @unique
  type      TokenType
  expiresAt DateTime
  isUsed    Boolean   @default(false)
  isRevoked Boolean   @default(false)
  userAgent String?
  ipAddress String?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
}

enum TokenType {
  ACCESS
  REFRESH
  RESET_PASSWORD
  VERIFY_EMAIL
  SET_PASSWORD
}

/////////////////////////////
// 🎓 ACADEMIC
/////////////////////////////
model Class {
  id Int @id @default(autoincrement())

  // =========================================
  // BASIC INFO
  // =========================================

  name String

  description String?

  schoolId Int

  school School @relation(fields: [schoolId], references: [id])

  // =========================================
  // CLASS SETTINGS
  // =========================================

  maxStudents Int?

  isActive Boolean @default(true)

  isDeleted Boolean @default(false)

  // =========================================
  // RELATIONS
  // =========================================

  sections Section[]

  syllabi Syllabus[]

  exams Exam[]

  classTeachers ClassTeacher[]

  teacherSubjects TeacherSubject[]

  timetables Timetable[]

  admissions Admission[]

  feeStructures FeeStructure[]

  academicRecords StudentAcademicRecord[]

  studentAttendanceSessions StudentAttendanceSession[]
  bookPackages              BookPackage[]

  // =========================================
  // AUDIT
  // =========================================

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  // =========================================
  // INDEXES
  // =========================================

  @@unique([name, schoolId])
  @@index([schoolId])
  @@index([isActive])
  @@index([isDeleted])
}

model Section {
  id Int @id @default(autoincrement())

  name String

  classId Int

  schoolId Int

  capacity Int?

  description String?

  isActive Boolean @default(true)

  class Class @relation(fields: [classId], references: [id])

  school                    School                     @relation(fields: [schoolId], references: [id])
  studentAttendanceSessions StudentAttendanceSession[]
  classTeachers             ClassTeacher[]

  teacherSubjects TeacherSubject[]

  timetables Timetable[]

  admissions      Admission[]
  exams           Exam[]
  academicRecords StudentAcademicRecord[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@unique([schoolId, name, classId])
}

model Grade {
  id          Int        @id @default(autoincrement())
  name        String
  schoolId    Int
  description String?
  isActive    Boolean    @default(true)
  isDeleted   Boolean    @default(false)
  syllabi     Syllabus[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@unique([name, schoolId])
}

model Subject {
  id              Int              @id @default(autoincrement())
  name            String
  description     String?
  isActive        Boolean          @default(true)
  schoolId        Int
  code            String
  maxMarks        Int? // ✅ ADD
  passMarks       Int?
  syllabi         Syllabus[]
  teacherSubjects TeacherSubject[]
  examSubjects    ExamSubject[]
  timetables      Timetable[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@unique([code, schoolId])
}

model Syllabus {
  id          Int         @id @default(autoincrement())
  subjectId   Int
  gradeId     Int?
  classId     Int?
  schoolId    Int
  description String?
  type        SubjectType @default(CORE)
  chapters    Json
  maxMarks    Int?
  passMarks   Int?
  isActive    Boolean     @default(true)
  isDeleted   Boolean     @default(false)
  subject     Subject     @relation(fields: [subjectId], references: [id])
  grade       Grade?      @relation(fields: [gradeId], references: [id])
  class       Class?      @relation(fields: [classId], references: [id])
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@unique([subjectId, gradeId, classId, schoolId])
}

enum SubjectType {
  CORE
  EXTRA
  THEORY
  PRACTICAL
  BOTH
}

model ClassTeacher {
  id Int @id @default(autoincrement())

  teacherId Int
  classId   Int
  sectionId Int

  teacher Teacher @relation(fields: [teacherId], references: [id])
  class   Class   @relation(fields: [classId], references: [id])
  section Section @relation(fields: [sectionId], references: [id])

  createdAt DateTime @default(now())

  // ⭐ ek class + section ka sirf 1 class teacher
  @@unique([classId, sectionId])
}

model Day {
  id         Int         @id @default(autoincrement())
  schoolId   Int
  name       String
  shortName  String
  order      Int
  maxPeriods Int
  isActive   Boolean     @default(true)
  isHalfDay  Boolean     @default(false)
  timetables Timetable[]

  school  School   @relation(fields: [schoolId], references: [id])
  periods Period[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([schoolId, name])
}

model TeacherSubject {
  id Int @id @default(autoincrement())

  teacherId Int
  subjectId Int
  classId   Int
  sectionId Int
  // schoolId Int

  teacher Teacher @relation(fields: [teacherId], references: [id])
  subject Subject @relation(fields: [subjectId], references: [id])
  class   Class   @relation(fields: [classId], references: [id])
  section Section @relation(fields: [sectionId], references: [id])

  // ⭐ same subject same class same section duplicate nahi
  // @@unique([teacherId, subjectId, classId, sectionId])
  // @@unique([schoolId, teacherId, subjectId, classId, sectionId])
}

model SchoolTiming {
  id           Int    @id @default(autoincrement())
  schoolId     Int
  academicYear String

  type TimingType @default(REGULAR)

  school School @relation(fields: [schoolId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([schoolId, academicYear, type])
}

enum TimingType {
  REGULAR
  WINTER
  RAMADAN
  EXAM
}

model Period {
  id             Int        @id @default(autoincrement())
  schoolId       Int
  academicYearId Int
  timingType     TimingType @default(REGULAR)

  dayId        Int
  periodNumber Int

  startTime String
  endTime   String

  isBreak  Boolean @default(false)
  isActive Boolean @default(true)

  school     School      @relation(fields: [schoolId], references: [id])
  day        Day         @relation(fields: [dayId], references: [id])
  timetables Timetable[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([schoolId, academicYearId, dayId, periodNumber])
  @@index([schoolId, academicYearId])
}

model AcademicYear {
  id Int @id @default(autoincrement())

  schoolId Int

  name String

  startDate DateTime?

  endDate DateTime?

  isActive Boolean @default(true)

  school School @relation(fields: [schoolId], references: [id])

  admissions      Admission[]
  exams           Exam[]
  academicRecords StudentAcademicRecord[]
  feeStructures   FeeStructure[]
  createdAt       DateTime                @default(now())

  updatedAt DateTime @updatedAt
}

model Timetable {
  id Int @id @default(autoincrement())

  schoolId  Int
  classId   Int
  sectionId Int
  subjectId Int
  teacherId Int

  dayId          Int
  periodId       Int
  academicYearId Int

  startTime String
  endTime   String
  //   effectiveFrom DateTime
  // effectiveTo   DateTime?

  school  School  @relation(fields: [schoolId], references: [id])
  class   Class   @relation(fields: [classId], references: [id])
  section Section @relation(fields: [sectionId], references: [id])
  subject Subject @relation(fields: [subjectId], references: [id])
  teacher Teacher @relation(fields: [teacherId], references: [id])
  period  Period  @relation(fields: [periodId], references: [id])
  day     Day     @relation(fields: [dayId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  //   @@unique([schoolId, sectionId, dayId, periodId, academicYearId, effectiveFrom])
  // @@unique([schoolId, teacherId, dayId, periodId, academicYearId, effectiveFrom])

  @@unique([sectionId, dayId, periodId, academicYearId])
  @@unique([teacherId, dayId, periodId, academicYearId])
  @@index([schoolId, academicYearId])
}

// enum DayOfWeek {
//   MONDAY
//   TUESDAY
//   WEDNESDAY
//   THURSDAY
//   FRIDAY
//   SATURDAY
// }

/////////////////////////////
// 👨‍🎓 STUDENTS & PARENTS
/////////////////////////////
model Student {
  id Int @id @default(autoincrement())

  schoolId Int

  userId Int? @unique

  name String

  profilePhoto String?

  studentCode String @unique

  dob DateTime?

  gender Gender?

  address String?

  phoneNumber String?

  email String?

  isActive Boolean @default(true)

  isDeleted Boolean @default(false)

  school School @relation(fields: [schoolId], references: [id])

  user User? @relation(fields: [userId], references: [id])

  admissions          Admission[]
  examMarks           ExamMark[]
  academicRecords     StudentAcademicRecord[]
  attendanceRecords   StudentAttendanceRecord[]
  parents             StudentParent[]
  studentFees         StudentFee[]
  studentScholarships StudentScholarship[]
  createdAt           DateTime                  @default(now())

  updatedAt DateTime @updatedAt

  @@index([schoolId])
}

model StudentAcademicRecord {
  id Int @id @default(autoincrement())

  schoolId Int

  studentId Int

  academicYearId Int

  classId Int

  sectionId Int?

  rollNumber Int

  admissionNo String

  isCurrent Boolean @default(true)

  status AcademicRecordStatus @default(ACTIVE)

  promotedFromId Int?

  school School @relation(fields: [schoolId], references: [id])

  student Student @relation(fields: [studentId], references: [id])

  academicYear AcademicYear @relation(fields: [academicYearId], references: [id])

  class            Class @relation(fields: [classId], references: [id])
  transportRouteId Int?

  transportRoute TransportRoute? @relation(fields: [transportRouteId], references: [id])
  section        Section?        @relation(fields: [sectionId], references: [id])

  promotedFrom StudentAcademicRecord? @relation("PromotionHistory", fields: [promotedFromId], references: [id])

  promotedTo StudentAcademicRecord[] @relation("PromotionHistory")

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@index([schoolId])
  @@index([studentId])
  @@index([academicYearId])
}

enum AcademicRecordStatus {
  ACTIVE
  PROMOTED
  REVERTED
  TRANSFERRED
  COMPLETED
  DROPPED
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

model Parent {
  id       Int @id @default(autoincrement())
  userId   Int @unique
  schoolId Int

  fatherName       String?
  fatherPhone      String?
  fatherEmail      String?
  fatherOccupation String?

  motherName       String?
  motherPhone      String?
  motherEmail      String?
  motherOccupation String?

  guardianName     String?
  guardianRelation String?
  guardianPhone    String?
  // ✅ Relations
  user             User    @relation(fields: [userId], references: [id])
  school           School  @relation(fields: [schoolId], references: [id])

  students StudentParent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId])
}

model StudentParent {
  studentId Int
  parentId  Int

  // ✅ Relations
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  parent  Parent  @relation(fields: [parentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([studentId, parentId])
  @@index([parentId])
}

model Admission {
  id Int @id @default(autoincrement())

  schoolId Int

  studentId Int?

  studentName String

  dob DateTime?

  gender      Gender?
  address     String?
  phoneNumber String?
  email       String?

  classId Int

  sectionId Int?

  academicYearId     Int
  previousSchool     String?
  previousClass      String?
  previousPercentage Float?

  rollNumber Int?

  admissionNo String?

  bloodGroup String?

  nationality String?

  religion String?

  caste String?

  aadharNumber String?

  fatherName String?

  fatherPhone String?

  fatherEmail String?

  fatherOccupation String?

  motherName String?

  motherPhone String?

  motherEmail String?

  motherOccupation String?

  guardianName String?

  guardianRelation String?

  guardianPhone String?

  guardianEmail String?
  status        AdmissionStatus @default(PENDING)
  approvedAt    DateTime?

  admissionType AdmissionType @default(NEW)
  admissionDate DateTime?     @default(now())

  medium String?

  previousBoard String?

  tcNumber String?
  student  Student? @relation(fields: [studentId], references: [id])

  school School @relation(fields: [schoolId], references: [id])

  class Class @relation(fields: [classId], references: [id])

  section Section? @relation(fields: [sectionId], references: [id])

  academicYear AcademicYear @relation(fields: [academicYearId], references: [id])

  createdAt DateTime @default(now())

  @@index([schoolId])
}

enum AdmissionType {
  NEW
  TRANSFER
  READMISSION
}

enum AdmissionStatus {
  PENDING // 🔥 new application
  APPROVED // 🔥 admin verified
  ACTIVE
  CANCELLED
  TRANSFERRED
  COMPLETED
}

/////////////////////////////
// 📋 ATTENDANCE (ADVANCED)
/////////////////////////////

model StudentAttendanceSession {
  id             Int      @id @default(autoincrement())
  schoolId       Int
  classId        Int
  sectionId      Int?
  markedById     Int
  attendanceDate DateTime @db.Date
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // =====================================
  // RELATIONS
  // =====================================

  school School @relation("SchoolStudentAttendanceSessions", fields: [schoolId], references: [id])

  class Class @relation(fields: [classId], references: [id])

  section Section? @relation(fields: [sectionId], references: [id])

  markedBy User                      @relation(fields: [markedById], references: [id])
  records  StudentAttendanceRecord[]

  // =====================================
  // UNIQUE
  // =====================================
  @@unique([schoolId, classId, sectionId, attendanceDate])
  // ====================================
  // INDEXES
  // =====================================
  @@index([schoolId, attendanceDate])
}

model StudentAttendanceRecord {
  id Int @id @default(autoincrement())

  sessionId Int

  studentId Int

  status AttendanceStatus

  remarks String?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  // =====================================
  // RELATIONS
  // =====================================

  session StudentAttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  // =====================================
  // INDEXES
  // =====================================

  // =====================================
  // UNIQUE
  // =====================================

  @@unique([sessionId, studentId])
  @@index([studentId])
}

model EmployeeAttendance {
  id Int @id @default(autoincrement())

  schoolId Int

  employeeId Int

  attendanceDate DateTime @db.Date

  checkInTime DateTime?

  checkOutTime DateTime?

  status EmployeeAttendanceStatus

  remarks String?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  // =====================================
  // RELATIONS
  // =====================================

  school School @relation("SchoolEmployeeAttendances", fields: [schoolId], references: [id])

  employee User @relation(fields: [employeeId], references: [id])

  // =====================================
  // UNIQUE
  // =====================================
  @@unique([employeeId, attendanceDate])
  // =====================================
  // INDEXES
  // =====================================
  @@index([schoolId, attendanceDate])
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  HALF_DAY
  LEAVE
}

enum EmployeeAttendanceStatus {
  PRESENT
  ABSENT
  LATE
  HALF_DAY
  LEAVE
  HOLIDAY
}

/////////////////////////////
// 👩‍🏫 TEACHERS & STAFF
/////////////////////////////
model Staff {
  id            Int @id @default(autoincrement())
  userId        Int
  schoolId      Int
  designationId Int
}

model Designation {
  id   Int    @id @default(autoincrement())
  name String
}

model Payroll {
  id      Int    @id @default(autoincrement())
  staffId Int
  salary  Float
  month   String
}

/////////////////////////////
// 💰 FEES & PAYMENTS
/////////////////////////////

////////////////////////////////////////////////////////
// 💰 FEE HEAD MASTER
////////////////////////////////////////////////////////

model FeeHead {
  id Int @id @default(autoincrement())

  schoolId Int

  name String

  description String?

  isOptional Boolean @default(false)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  // =====================================
  // RELATIONS
  // =====================================

  school School @relation(fields: [schoolId], references: [id])

  feeStructureItems FeeStructureItem[]

  studentFeeItems StudentFeeItem[]

  @@unique([schoolId, name])
}

////////////////////////////////////////////////////////
// 💰 FEE STRUCTURE
////////////////////////////////////////////////////////

model FeeStructure {
  id Int @id @default(autoincrement())

  schoolId Int

  academicYearId Int

  classId Int

  name       String
  isActive   Boolean @default(true)
  dueDay     Int
  monthlyFee Float   @default(0)

  yearlyFee Float @default(0)

  oneTimeFee Float @default(0)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  // =====================================
  // RELATIONS
  // =====================================

  school School @relation(fields: [schoolId], references: [id])

  academicYear AcademicYear @relation(fields: [academicYearId], references: [id])

  class Class @relation(fields: [classId], references: [id])

  items FeeStructureItem[]

  studentFees StudentFee[]

  // =====================================
  // UNIQUE
  // =====================================

  @@unique([schoolId, academicYearId, classId])
  @@index([schoolId])
  @@index([classId])
}

model FeeStructureItem {
  id Int @id @default(autoincrement())

  feeStructureId Int

  feeHeadId Int

  amount Decimal @db.Decimal(10, 2)

  frequency FeeFrequency

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  // =====================================
  // RELATIONS
  // =====================================

  feeStructure FeeStructure @relation(fields: [feeStructureId], references: [id], onDelete: Cascade)

  feeHead FeeHead @relation(fields: [feeHeadId], references: [id])

  @@unique([feeStructureId, feeHeadId])
}

////////////////////////////////////////////////////////
// 💰 FEE STRUCTURE ITEMS
////////////////////////////////////////////////////////

////////////////////////////////////////////////////////
// 🚌 TRANSPORT ROUTES
////////////////////////////////////////////////////////

model TransportRoute {
  id Int @id @default(autoincrement())

  schoolId Int

  name String

  pickupPoint String?

  amount Float

  isActive Boolean @default(true)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  // =====================================
  // RELATIONS
  // =====================================

  school School @relation(fields: [schoolId], references: [id])

  studentAcademicRecords StudentAcademicRecord[]

  @@unique([schoolId, name])
}

////////////////////////////////////////////////////////
// 📚 BOOK PACKAGE
////////////////////////////////////////////////////////

model BookPackage {
  id Int @id @default(autoincrement())

  schoolId Int

  classId Int

  name String

  amount Float

  isActive Boolean @default(true)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  // =====================================
  // RELATIONS
  // =====================================

  school School @relation(fields: [schoolId], references: [id])

  class Class @relation(fields: [classId], references: [id])
}

////////////////////////////////////////////////////////
// 🧾 STUDENT FEES / INVOICES
////////////////////////////////////////////////////////

model StudentFee {
  id Int @id @default(autoincrement())

  invoiceNo String? @unique

  schoolId Int

  studentId Int

  feeStructureId Int

  month Int?

  year Int?

  totalAmount Decimal @db.Decimal(10, 2)

  paidAmount Decimal @default(0) @db.Decimal(10, 2)

  dueAmount Decimal @db.Decimal(10, 2)

  lateFee Decimal @default(0) @db.Decimal(10, 2)

  discount Decimal @default(0) @db.Decimal(10, 2)

  isAdmissionFee Boolean @default(false)

  status FeeStatus @default(PENDING)

  dueDate DateTime

  remarks String?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  // =====================================
  // RELATIONS
  // =====================================

  school School @relation(fields: [schoolId], references: [id])

  student Student @relation(fields: [studentId], references: [id])

  feeStructure FeeStructure @relation(fields: [feeStructureId], references: [id])

  items StudentFeeItem[]

  receipts PaymentReceipt[]

  @@unique([studentId, feeStructureId, month, year])
  @@index([studentId])
  @@index([schoolId])
  @@index([status])
}

model StudentFeeItem {
  id Int @id @default(autoincrement())

  studentFeeId Int

  feeHeadId Int

  amount Decimal @db.Decimal(10, 2)

  frequency FeeFrequency

  createdAt DateTime @default(now())

  // =====================================
  // RELATIONS
  // =====================================

  studentFee StudentFee @relation(fields: [studentFeeId], references: [id], onDelete: Cascade)

  feeHead FeeHead @relation(fields: [feeHeadId], references: [id])

  @@index([studentFeeId])
  @@index([feeHeadId])
}

////////////////////////////////////////////////////////
// 🧾 PAYMENT RECEIPTS
////////////////////////////////////////////////////////

model PaymentReceipt {
  id Int @id @default(autoincrement())

  schoolId Int

  studentFeeId Int

  receiptNo String @unique

  amount Float

  paymentDate DateTime @default(now())

  paymentMethod PaymentMethod

  transactionId String?

  remarks String?

  receivedById Int?

  status PaymentTransactionStatus @default(SUCCESS)

  createdAt DateTime @default(now())

  // =====================================
  // RELATIONS
  // =====================================

  school School @relation(fields: [schoolId], references: [id])

  studentFee StudentFee @relation(fields: [studentFeeId], references: [id])

  receivedBy User? @relation(fields: [receivedById], references: [id])
}

////////////////////////////////////////////////////////
// ENUMS
////////////////////////////////////////////////////////

enum FeeStatus {
  PAID

  PARTIAL

  PENDING

  OVERDUE
}

////////////////////////////////////////////////////////

enum PaymentMethod {
  CASH

  ONLINE

  UPI

  CARD

  BANK_TRANSFER
}

model StudentScholarship {
  id Int @id @default(autoincrement())

  schoolId Int

  studentId Int

  scholarshipId Int

  isActive Boolean @default(true)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  // =====================================
  // RELATIONS
  // =====================================

  school School @relation(fields: [schoolId], references: [id])

  student Student @relation(fields: [studentId], references: [id])

  scholarship Scholarship @relation(fields: [scholarshipId], references: [id])

  @@unique([studentId, scholarshipId])
}

model Scholarship {
  id Int @id @default(autoincrement())

  schoolId Int

  name String

  type ScholarshipType

  amount Float

  description String?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  school School @relation(fields: [schoolId], references: [id])

  studentScholarships StudentScholarship[]
}

////////////////////////////////////////////////////////

enum PaymentTransactionStatus {
  SUCCESS

  FAILED

  PENDING
}

enum FeeFrequency {
  MONTHLY

  QUARTERLY

  HALF_YEARLY

  YEARLY

  ONE_TIME
}

enum ScholarshipType {
  FIXED

  PERCENTAGE
}

/////////////////////////////
// 📝 EXAMS & RESULTS
/////////////////////////////

/////////////////////////////
// 📝 EXAM
/////////////////////////////

model Exam {
  id Int @id @default(autoincrement())

  schoolId Int

  academicYearId Int

  classId Int

  sectionId Int?

  name String

  examType ExamType

  startDate DateTime

  endDate DateTime

  isPublished Boolean @default(false)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  // =====================================
  // RELATIONS
  // =====================================

  school School @relation(fields: [schoolId], references: [id])

  academicYear AcademicYear @relation(fields: [academicYearId], references: [id])

  class Class @relation(fields: [classId], references: [id])

  section Section? @relation(fields: [sectionId], references: [id])

  subjects ExamSubject[]
}

/////////////////////////////
// 📝 EXAM SUBJECTS
/////////////////////////////

model ExamSubject {
  id Int @id @default(autoincrement())

  examId Int

  subjectId Int

  examDate DateTime

  totalMarks Float

  passingMarks Float

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  // =====================================
  // RELATIONS
  // =====================================

  exam Exam @relation(fields: [examId], references: [id], onDelete: Cascade)

  subject Subject @relation(fields: [subjectId], references: [id])

  marks ExamMark[]

  // =====================================
  // UNIQUE
  // =====================================

  @@unique([examId, subjectId])
}

/////////////////////////////
// 📝 EXAM MARKS
/////////////////////////////

model ExamMark {
  id Int @id @default(autoincrement())

  examSubjectId Int

  studentId Int

  obtainedMarks Float

  remarks String?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  // =====================================
  // RELATIONS
  // =====================================

  examSubject ExamSubject @relation(fields: [examSubjectId], references: [id], onDelete: Cascade)

  student Student @relation(fields: [studentId], references: [id])

  // =====================================
  // UNIQUE
  // =====================================

  @@unique([examSubjectId, studentId])
}

/////////////////////////////
// 📝 EXAM TYPE
/////////////////////////////

enum ExamType {
  UNIT_TEST

  MID_TERM

  FINAL_EXAM

  PRACTICAL
}

/////////////////////////////
// 🧾 AUDIT LOG (ENTERPRISE)
/////////////////////////////

model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int
  action    String
  entity    String
  entityId  Int?
  createdAt DateTime @default(now())
}
