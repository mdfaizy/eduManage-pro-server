/////////////////////////////
// 🎓 ACADEMIC
/////////////////////////////
model Class {
  id Int @id @default(autoincrement())

  // =========================================
  // BASIC INFO
  // =========================================

  name String

  description String?

  schoolId Int

  school School @relation(fields: [schoolId], references: [id])

  // =========================================
  // CLASS SETTINGS
  // =========================================

  maxStudents Int?

  isActive Boolean @default(true)

  isDeleted Boolean @default(false)

  // =========================================
  // RELATIONS
  // =========================================

  sections Section[]

  syllabi Syllabus[]

  exams Exam[]

  classTeachers ClassTeacher[]

  teacherSubjects TeacherSubject[]

  timetables Timetable[]

  admissions Admission[]

  feeStructures FeeStructure[]

  academicRecords StudentAcademicRecord[]

  studentAttendanceSessions StudentAttendanceSession[]
  bookPackages              BookPackage[]

  // =========================================
  // AUDIT
  // =========================================

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  // =========================================
  // INDEXES
  // =========================================

  @@unique([name, schoolId])
  @@index([schoolId])
  @@index([isActive])
  @@index([isDeleted])
}

model Section {
  id Int @id @default(autoincrement())

  name String

  classId Int

  schoolId Int

  capacity Int?

  description String?

  isActive Boolean @default(true)

  class Class @relation(fields: [classId], references: [id])

  school                    School                     @relation(fields: [schoolId], references: [id])
  studentAttendanceSessions StudentAttendanceSession[]
  classTeachers             ClassTeacher[]

  teacherSubjects TeacherSubject[]

  timetables Timetable[]

  admissions      Admission[]
  exams           Exam[]
  academicRecords StudentAcademicRecord[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@unique([schoolId, name, classId])
}

model Grade {
  id          Int        @id @default(autoincrement())
  name        String
  schoolId    Int
  description String?
  isActive    Boolean    @default(true)
  isDeleted   Boolean    @default(false)
  syllabi     Syllabus[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@unique([name, schoolId])
}

model Subject {
  id              Int              @id @default(autoincrement())
  name            String
  description     String?
  isActive        Boolean          @default(true)
  schoolId        Int
  code            String
  maxMarks        Int? // ✅ ADD
  passMarks       Int?
  syllabi         Syllabus[]
  teacherSubjects TeacherSubject[]
  examSubjects    ExamSubject[]
  timetables      Timetable[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@unique([code, schoolId])
}

model Syllabus {
  id          Int         @id @default(autoincrement())
  subjectId   Int
  gradeId     Int?
  classId     Int?
  schoolId    Int
  description String?
  type        SubjectType @default(CORE)
  chapters    Json
  maxMarks    Int?
  passMarks   Int?
  isActive    Boolean     @default(true)
  isDeleted   Boolean     @default(false)
  subject     Subject     @relation(fields: [subjectId], references: [id])
  grade       Grade?      @relation(fields: [gradeId], references: [id])
  class       Class?      @relation(fields: [classId], references: [id])
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@unique([subjectId, gradeId, classId, schoolId])
}

enum SubjectType {
  CORE
  EXTRA
  THEORY
  PRACTICAL
  BOTH
}

model ClassTeacher {
  id Int @id @default(autoincrement())

  teacherId Int
  classId   Int
  sectionId Int

  teacher Teacher @relation(fields: [teacherId], references: [id])
  class   Class   @relation(fields: [classId], references: [id])
  section Section @relation(fields: [sectionId], references: [id])

  createdAt DateTime @default(now())

  // ⭐ ek class + section ka sirf 1 class teacher
  @@unique([classId, sectionId])
}

model Day {
  id         Int         @id @default(autoincrement())
  schoolId   Int
  name       String
  shortName  String
  order      Int
  maxPeriods Int
  isActive   Boolean     @default(true)
  isHalfDay  Boolean     @default(false)
  timetables Timetable[]

  school  School   @relation(fields: [schoolId], references: [id])
  periods Period[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([schoolId, name])
}

model TeacherSubject {
  id Int @id @default(autoincrement())

  teacherId Int
  subjectId Int
  classId   Int
  sectionId Int
  // schoolId Int

  teacher Teacher @relation(fields: [teacherId], references: [id])
  subject Subject @relation(fields: [subjectId], references: [id])
  class   Class   @relation(fields: [classId], references: [id])
  section Section @relation(fields: [sectionId], references: [id])

  // ⭐ same subject same class same section duplicate nahi
  // @@unique([teacherId, subjectId, classId, sectionId])
  // @@unique([schoolId, teacherId, subjectId, classId, sectionId])
}

model SchoolTiming {
  id           Int    @id @default(autoincrement())
  schoolId     Int
  academicYear String

  type TimingType @default(REGULAR)

  school School @relation(fields: [schoolId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([schoolId, academicYear, type])
}

enum TimingType {
  REGULAR
  WINTER
  RAMADAN
  EXAM
}

model Period {
  id             Int        @id @default(autoincrement())
  schoolId       Int
  academicYearId Int
  timingType     TimingType @default(REGULAR)

  dayId        Int
  periodNumber Int

  startTime String
  endTime   String

  isBreak  Boolean @default(false)
  isActive Boolean @default(true)

  school     School      @relation(fields: [schoolId], references: [id])
  day        Day         @relation(fields: [dayId], references: [id])
  timetables Timetable[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([schoolId, academicYearId, dayId, periodNumber])
  @@index([schoolId, academicYearId])
}

model AcademicYear {
  id Int @id @default(autoincrement())

  schoolId Int

  name String

  startDate DateTime?

  endDate DateTime?

  isActive Boolean @default(true)

  school School @relation(fields: [schoolId], references: [id])

  admissions      Admission[]
  exams           Exam[]
  academicRecords StudentAcademicRecord[]
  feeStructures   FeeStructure[]
  createdAt       DateTime                @default(now())

  updatedAt DateTime @updatedAt
}

model Timetable {
  id Int @id @default(autoincrement())

  schoolId  Int
  classId   Int
  sectionId Int
  subjectId Int
  teacherId Int

  dayId          Int
  periodId       Int
  academicYearId Int

  startTime String
  endTime   String
  //   effectiveFrom DateTime
  // effectiveTo   DateTime?

  school  School  @relation(fields: [schoolId], references: [id])
  class   Class   @relation(fields: [classId], references: [id])
  section Section @relation(fields: [sectionId], references: [id])
  subject Subject @relation(fields: [subjectId], references: [id])
  teacher Teacher @relation(fields: [teacherId], references: [id])
  period  Period  @relation(fields: [periodId], references: [id])
  day     Day     @relation(fields: [dayId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  //   @@unique([schoolId, sectionId, dayId, periodId, academicYearId, effectiveFrom])
  // @@unique([schoolId, teacherId, dayId, periodId, academicYearId, effectiveFrom])

  @@unique([sectionId, dayId, periodId, academicYearId])
  @@unique([teacherId, dayId, periodId, academicYearId])
  @@index([schoolId, academicYearId])
}

///////////////////////////////////////////////////////////////
// 📋 ATTENDANCE MODULE
///////////////////////////////////////////////////////////////

///////////////////////////////////////////////////////////////
// STUDENT ATTENDANCE SESSION
///////////////////////////////////////////////////////////////

model StudentAttendanceSession {
  id Int @id @default(autoincrement())

  schoolId Int

  classId Int

  sectionId Int?

  markedById Int

  attendanceDate DateTime @db.Date

  /////////////////////////////////////////////////////////////
  // RELATIONS
  /////////////////////////////////////////////////////////////

  school School @relation("SchoolStudentAttendanceSessions", fields: [schoolId], references: [id])

  class Class @relation(fields: [classId], references: [id])

  section Section? @relation(fields: [sectionId], references: [id])

  markedBy User @relation(fields: [markedById], references: [id])

  records StudentAttendanceRecord[]

  /////////////////////////////////////////////////////////////

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  /////////////////////////////////////////////////////////////

  @@unique([schoolId, classId, sectionId, attendanceDate])
  @@index([schoolId, attendanceDate])
}

///////////////////////////////////////////////////////////////
// STUDENT ATTENDANCE RECORD
///////////////////////////////////////////////////////////////

model StudentAttendanceRecord {
  id Int @id @default(autoincrement())

  sessionId Int

  studentId Int

  status AttendanceStatus

  remarks String?

  /////////////////////////////////////////////////////////////
  // RELATIONS
  /////////////////////////////////////////////////////////////

  session StudentAttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  /////////////////////////////////////////////////////////////

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  /////////////////////////////////////////////////////////////

  @@unique([sessionId, studentId])
  @@index([studentId])
}

///////////////////////////////////////////////////////////////
// EMPLOYEE ATTENDANCE
///////////////////////////////////////////////////////////////

model EmployeeAttendance {
  id Int @id @default(autoincrement())

  schoolId Int

  employeeId Int

  attendanceDate DateTime @db.Date

  checkInTime DateTime?

  checkOutTime DateTime?

  status EmployeeAttendanceStatus

  remarks String?

  /////////////////////////////////////////////////////////////
  // RELATIONS
  /////////////////////////////////////////////////////////////

  school School @relation("SchoolEmployeeAttendances", fields: [schoolId], references: [id])

  employee User @relation(fields: [employeeId], references: [id])

  /////////////////////////////////////////////////////////////

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  /////////////////////////////////////////////////////////////

  @@unique([employeeId, attendanceDate])
  @@index([schoolId, attendanceDate])
}

///////////////////////////////////////////////////////////////
// STUDENT ATTENDANCE STATUS
///////////////////////////////////////////////////////////////

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  HALF_DAY
  LEAVE
}

///////////////////////////////////////////////////////////////
// EMPLOYEE ATTENDANCE STATUS
///////////////////////////////////////////////////////////////

enum EmployeeAttendanceStatus {
  PRESENT
  ABSENT
  LATE
  HALF_DAY
  LEAVE
  HOLIDAY
}

///////////////////////////////////////////////////////////////
// 🔐 AUTH & RBAC
///////////////////////////////////////////////////////////////

model User {
  id       Int    @id @default(autoincrement())
  name     String
  email    String @unique
  password String

  isActive      Boolean    @default(true)
  isDeleted     Boolean    @default(false)
  emailVerified Boolean    @default(false)
  schoolId      Int?
  /////////////////////////////////////////////////////////////
  // RELATIONS
  /////////////////////////////////////////////////////////////
  school        School?    @relation(fields: [schoolId], references: [id])
  teacher       Teacher?
  student       Student?
  parent        Parent?
  roles         UserRole[]
  tokens        Token[]
  // reports Report[]  
  // userPermissions UserPermission[]
  // paymentReceipts PaymentReceipt[]
  // markedAttendances StudentAttendanceSession[]
  // employeeAttendanceRecords EmployeeAttendance[]

  reports Report[]

  userPermissions UserPermission[]

  // paymentReceipts PaymentReceipt[]

  // paymentsCollected Payment[]
  // refundsProcessed Refund[]

  paymentReceipts PaymentReceipt[] @relation("PaymentReceiptReceivedBy")

  paymentsCollected Payment[] @relation("PaymentCollectedBy")

  refundsProcessed Refund[] @relation("RefundProcessedBy")

  markedAttendances         StudentAttendanceSession[]
  employeeAttendanceRecords EmployeeAttendance[]
  lateFeeWaiversProcessed   LateFeeWaiver[]
  /////////////////////////////////////////////////////////////
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt
}

///////////////////////////////////////////////////////////////

model Role {
  id Int @id @default(autoincrement())

  name String

  schoolId Int?

  profileType String?

  users UserRole[]

  permissions RolePermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name, schoolId])
}

///////////////////////////////////////////////////////////////

model Permission {
  id Int @id @default(autoincrement())

  key String @unique

  description String?

  roles RolePermission[]

  userPermissions UserPermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

///////////////////////////////////////////////////////////////

model UserRole {
  userId Int

  roleId Int

  user User @relation(fields: [userId], references: [id])

  role Role @relation(fields: [roleId], references: [id])

  @@id([userId, roleId])
}

///////////////////////////////////////////////////////////////

model UserPermission {
  id Int @id @default(autoincrement())

  userId Int

  permissionId Int

  granted Boolean @default(true)

  user User @relation(fields: [userId], references: [id])

  permission Permission @relation(fields: [permissionId], references: [id])

  @@unique([userId, permissionId])
}

///////////////////////////////////////////////////////////////

model RolePermission {
  roleId Int

  permissionId Int

  role Role @relation(fields: [roleId], references: [id])

  permission Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
}

///////////////////////////////////////////////////////////////

model Token {
  id        Int       @id @default(autoincrement())
  userId    Int
  tokenHash String    @unique
  type      TokenType
  expiresAt DateTime
  isUsed    Boolean   @default(false)
  isRevoked Boolean   @default(false)
  userAgent String?
  ipAddress String?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
}

///////////////////////////////////////////////////////////////
enum TokenType {
  ACCESS
  REFRESH
  RESET_PASSWORD
  VERIFY_EMAIL
  SET_PASSWORD
}

enum FeeFrequency {
  MONTHLY

  QUARTERLY

  HALF_YEARLY

  YEARLY

  ONE_TIME
}

///////////////////////////////////////////////////////////////
// 💰 FEE STATUS
///////////////////////////////////////////////////////////////

enum FeeStatus {
  PAID

  PARTIAL

  PENDING

  OVERDUE
}

///////////////////////////////////////////////////////////////
// 💳 PAYMENT METHOD
///////////////////////////////////////////////////////////////

enum PaymentMethod {
  CASH

  ONLINE

  UPI

  CARD

  BANK_TRANSFER

  CHEQUE

  OTHER
}

///////////////////////////////////////////////////////////////
// 💳 PAYMENT TRANSACTION STATUS
///////////////////////////////////////////////////////////////
enum PaymentTransactionStatus {
  SUCCESS
  FAILED
  PENDING
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
}

///////////////////////////////////////////////////////////////
// 📊 REPORT TYPES
///////////////////////////////////////////////////////////////

enum ReportType {
  FEE_COLLECTION

  PENDING_FEE

  STUDENT_LEDGER

  SCHOLARSHIP

  DISCOUNT
}

///////////////////////////////////////////////////////////////
// 🎓 SCHOLARSHIP TYPE
///////////////////////////////////////////////////////////////

enum ScholarshipType {
  FIXED

  PERCENTAGE
}

///////////////////////////////////////////////////////////////
// 💸 DISCOUNT TYPE
///////////////////////////////////////////////////////////////

enum DiscountType {
  FIXED

  PERCENTAGE
}

///////////////////////////////////////////////////////////////
// 💸 DISCOUNT APPLY TYPE
///////////////////////////////////////////////////////////////

enum DiscountApplyType {
  ONE_TIME

  MONTHLY

  YEARLY
}

model Exam {
  id Int @id @default(autoincrement())

  schoolId Int

  academicYearId Int

  classId Int

  sectionId Int?

  name String

  examType ExamType

  startDate DateTime

  endDate DateTime

  isPublished Boolean @default(false)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  // =====================================
  // RELATIONS
  // =====================================

  school School @relation(fields: [schoolId], references: [id])

  academicYear AcademicYear @relation(fields: [academicYearId], references: [id])

  class Class @relation(fields: [classId], references: [id])

  section Section? @relation(fields: [sectionId], references: [id])

  subjects ExamSubject[]
}

/////////////////////////////
// 📝 EXAM SUBJECTS
/////////////////////////////

model ExamSubject {
  id Int @id @default(autoincrement())

  examId Int

  subjectId Int

  examDate DateTime

  totalMarks Float

  passingMarks Float

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  // =====================================
  // RELATIONS
  // =====================================

  exam Exam @relation(fields: [examId], references: [id], onDelete: Cascade)

  subject Subject @relation(fields: [subjectId], references: [id])

  marks ExamMark[]

  // =====================================
  // UNIQUE
  // =====================================

  @@unique([examId, subjectId])
}

/////////////////////////////
// 📝 EXAM MARKS
/////////////////////////////

model ExamMark {
  id Int @id @default(autoincrement())

  examSubjectId Int

  studentId Int

  obtainedMarks Float

  remarks String?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  // =====================================
  // RELATIONS
  // =====================================

  examSubject ExamSubject @relation(fields: [examSubjectId], references: [id], onDelete: Cascade)

  student Student @relation(fields: [studentId], references: [id])

  // =====================================
  // UNIQUE
  // =====================================

  @@unique([examSubjectId, studentId])
}

/////////////////////////////
// 📝 EXAM TYPE
/////////////////////////////

enum ExamType {
  UNIT_TEST

  MID_TERM

  FINAL_EXAM

  PRACTICAL
}

///////////////////////////////////////////////////////////////
// 💰 FEE MODULE
///////////////////////////////////////////////////////////////

///////////////////////////////////////////////////////////////
// FEE HEAD
///////////////////////////////////////////////////////////////
model FeeHead {
  id Int @id @default(autoincrement())

  /////////////////////////////////////////////////////////////
  // BASIC INFORMATION
  /////////////////////////////////////////////////////////////

  schoolId Int

  name String

  description String?

  isOptional Boolean @default(false)

  frequency DiscountApplyType @default(MONTHLY)
  isActive  Boolean           @default(true)

  /////////////////////////////////////////////////////////////
  // RELATIONS
  /////////////////////////////////////////////////////////////

  school School @relation(fields: [schoolId], references: [id])

  feeStructureItems FeeStructureItem[]

  studentFeeItems StudentFeeItem[]

  studentDiscounts StudentDiscount[]

  /////////////////////////////////////////////////////////////

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  /////////////////////////////////////////////////////////////

  @@unique([schoolId, name])
  @@index([schoolId])
}

///////////////////////////////////////////////////////////////
// FEE STRUCTURE
///////////////////////////////////////////////////////////////

model FeeStructure {
  id Int @id @default(autoincrement())

  /////////////////////////////////////////////////////////////
  // BASIC INFORMATION
  /////////////////////////////////////////////////////////////

  schoolId Int

  academicYearId Int

  classId Int

  name String

  /////////////////////////////////////////////////////////////
  // FEES
  /////////////////////////////////////////////////////////////

  monthlyFee Float @default(0)

  yearlyFee Float @default(0)

  oneTimeFee Float @default(0)

  dueDay Int

  isActive Boolean @default(true)

  /////////////////////////////////////////////////////////////
  // RELATIONS
  /////////////////////////////////////////////////////////////

  school School @relation(fields: [schoolId], references: [id])

  academicYear AcademicYear @relation(fields: [academicYearId], references: [id])

  class Class @relation(fields: [classId], references: [id])

  items FeeStructureItem[]

  studentFees StudentFee[]

  /////////////////////////////////////////////////////////////

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  /////////////////////////////////////////////////////////////

  @@unique([schoolId, academicYearId, classId])
  @@index([schoolId])
  @@index([classId])
  @@index([academicYearId])
}

///////////////////////////////////////////////////////////////
// FEE STRUCTURE ITEM
///////////////////////////////////////////////////////////////

model FeeStructureItem {
  id Int @id @default(autoincrement())

  /////////////////////////////////////////////////////////////

  feeStructureId Int

  feeHeadId Int

  amount Decimal @db.Decimal(10, 2)

  frequency FeeFrequency

  /////////////////////////////////////////////////////////////
  // RELATIONS
  /////////////////////////////////////////////////////////////

  feeStructure FeeStructure @relation(fields: [feeStructureId], references: [id], onDelete: Cascade)

  feeHead FeeHead @relation(fields: [feeHeadId], references: [id])

  /////////////////////////////////////////////////////////////

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  /////////////////////////////////////////////////////////////

  @@unique([feeStructureId, feeHeadId])
  @@index([feeStructureId])
  @@index([feeHeadId])
}

///////////////////////////////////////////////////////////////
// FEE FREQUENCY
///////////////////////////////////////////////////////////////

///////////////////////////////////////////////////////////////
// 🧾 STUDENT FEE
///////////////////////////////////////////////////////////////

model StudentFee {
  id Int @id @default(autoincrement())

  /////////////////////////////////////////////////////////////
  // BASIC INFORMATION
  /////////////////////////////////////////////////////////////

  invoiceNo String? @unique

  schoolId Int

  studentId Int

  feeStructureId Int

  month Int?

  year Int?

  /////////////////////////////////////////////////////////////
  // AMOUNT
  /////////////////////////////////////////////////////////////

  totalAmount Decimal @db.Decimal(10, 2)

  paidAmount Decimal @default(0) @db.Decimal(10, 2)

  dueAmount Decimal @db.Decimal(10, 2)

  lateFee Decimal @default(0) @db.Decimal(10, 2)

  discount Decimal @default(0) @db.Decimal(10, 2)

  /////////////////////////////////////////////////////////////

  isAdmissionFee Boolean @default(false)

  status FeeStatus @default(PENDING)

  dueDate DateTime

  remarks String?

  /////////////////////////////////////////////////////////////
  // RELATIONS
  /////////////////////////////////////////////////////////////

  school School @relation(fields: [schoolId], references: [id])

  student Student @relation(fields: [studentId], references: [id])

  feeStructure FeeStructure @relation(fields: [feeStructureId], references: [id])

  items StudentFeeItem[]

  // receipts PaymentReceipt[]

  payments Payment[]
  receipts PaymentReceipt[]
  // refunds   Refund[]
  refunds  Refund[]         @relation("StudentFeeRefunds")

  feeRefunds FeeRefund[] @relation("StudentFeeFeeRefunds")

  // feeRefunds FeeRefund[] @relation("StudentFeeFeeRefunds")
  lateFeeWaivers LateFeeWaiver[]
  /////////////////////////////////////////////////////////////

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  /////////////////////////////////////////////////////////////

  @@unique([studentId, feeStructureId, month, year])
  @@index([studentId])
  @@index([schoolId])
  @@index([status])
}

///////////////////////////////////////////////////////////////
// 🧾 STUDENT FEE ITEM
///////////////////////////////////////////////////////////////

model StudentFeeItem {
  id Int @id @default(autoincrement())

  studentFeeId Int

  feeHeadId Int

  amount Decimal @db.Decimal(10, 2)

  frequency FeeFrequency

  /////////////////////////////////////////////////////////////
  // RELATIONS
  /////////////////////////////////////////////////////////////

  studentFee StudentFee @relation(fields: [studentFeeId], references: [id], onDelete: Cascade)

  feeHead FeeHead @relation(fields: [feeHeadId], references: [id])

  /////////////////////////////////////////////////////////////

  createdAt DateTime @default(now())

  /////////////////////////////////////////////////////////////

  @@index([studentFeeId])
  @@index([feeHeadId])
}

